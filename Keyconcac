            ANSI_RESET +
            f"BYTES  : {byte_count}"
        )

        print(
            ANSI_CYAN +
            "│ " +
            ANSI_RESET +
            "STATUS : " +
            status_color +
            self.status +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            "╰────────────────────────────────────────────────────────────╯" +
            ANSI_RESET
        )


def read_character():
    return sys.stdin.read(1)


def editor_loop(editor, ui):
    with TerminalState():
        terminal_hide_cursor()

        ui.render(
            editor,
            "INPUT"
        )

        while True:
            char = read_character()

            if not char:
                return "exit"

            code = ord(char)

            if code == CTRL_R:
                return "exit"

            if code == CTRL_C:
                return "exit"

            if code == CTRL_U:
                return "encrypt"

            if code == CTRL_B:
                return "decrypt"

            if (
                code == BACKSPACE or
                code == BACKSPACE_ALT
            ):
                editor.backspace()

                ui.render(
                    editor,
                    "INPUT"
                )

                continue

            if (
                code == ENTER or
                code == LINE_FEED
            ):
                editor.add("\n")

                ui.render(
                    editor,
                    "INPUT"
                )

                continue

            if char.isprintable() or code >= 128:
                editor.add(char)

                ui.render(
                    editor,
                    "INPUT"
                )


def ask_key():
    terminal_show_cursor()

    print()

    print(
        ANSI_CYAN +
        ANSI_BOLD +
        "KEY" +
        ANSI_RESET
    )

    print(
        ANSI_DIM +
        "Key sẽ không hiển thị." +
        ANSI_RESET
    )

    key = getpass.getpass(
        "Nhập KEY: "
    )

    if not key:
        raise ValueError(
            "Key không được để trống."
        )

    return key


def process(key):
    editor = TextEditor()
    ui = UI()

    action = editor_loop(
        editor,
        ui
    )

    if action == "exit":
        return False

    text = editor.text()

    if not text:
        terminal_show_cursor()

        print()
        print(
            ANSI_YELLOW +
            "Không có nội dung." +
            ANSI_RESET
        )

        return True

    try:
        if action == "encrypt":
            encrypted = encrypt_text(
                text,
                key
            )

            path = save_encrypted(
                encrypted,
                key
            )

            terminal_show_cursor()

            print()

            print(
                ANSI_GREEN +
                ANSI_BOLD +
                "MÃ HÓA THÀNH CÔNG" +
                ANSI_RESET
            )

            print()

            print(encrypted)

            print()

            print(
                ANSI_GREEN +
                "Đã lưu vào:" +
                ANSI_RESET
            )

            print(path)

            print()

            return True

        if action == "decrypt":
            decrypted = decrypt_text(
                text,
                key
            )

            path = save_decrypted(
                decrypted
            )

            terminal_show_cursor()

            print()

            print(
                ANSI_GREEN +
                ANSI_BOLD +
                "GIẢI MÃ THÀNH CÔNG" +
                ANSI_RESET
            )

            print()

            print(decrypted)

            print()

            print(
                ANSI_GREEN +
                "Đã lưu vào:" +
                ANSI_RESET
            )

            print(path)

            print()

            return True

    except Exception as error:
        terminal_show_cursor()

        print()

        print(
            ANSI_RED +
            "LỖI: " +
            ANSI_RESET +
            str(error)
        )

        print()

        return True

    return True


def main():
    try:
        terminal_clear()
        terminal_show_cursor()

        print(
            ANSI_CYAN +
            ANSI_BOLD +
            PROGRAM_NAME +
            " " +
            VERSION +
            ANSI_RESET
        )

        print()

        print(
            ANSI_GRAY +
            "MCX3 / UTF-8 / PBKDF2 / HMAC / Auto Save" +
            ANSI_RESET
        )

        print()

        key = ask_key()

        print()

        print(
            ANSI_GREEN +
            "Key đã được nhận." +
            ANSI_RESET
        )

        print()

        while True:
            running = process(key)

            if not running:
                break

            print(
                ANSI_GRAY +
                "Ctrl+U = mã hóa | Ctrl+B = giải mã | Ctrl+R = thoát" +
                ANSI_RESET
            )

            print()

            input(
                "Nhấn Enter để tiếp tục..."
            )

            terminal_clear()

    except KeyboardInterrupt:
        pass

    except EOFError:
        pass

    except Exception as error:
        terminal_show_cursor()

        print()

        print(
            ANSI_RED +
            "Lỗi nghiêm trọng: " +
            ANSI_RESET +
            str(error)
        )

    finally:
        terminal_show_cursor()
        terminal_clear()

        print(
            ANSI_CYAN +
            PROGRAM_NAME +
            ANSI_RESET
        )

        print(
            ANSI_GREEN +
            "Đã thoát an toàn." +
            ANSI_RESET
        )


if __name__ == "__main__":
    main()
