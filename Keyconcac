#!/usr/bin/env python3

"""
MC CUSTOM CIPHER
================

Một chương trình mã hóa / giải mã chạy trực tiếp trong Termux.

Điều khiển:

    Ctrl + U
        Mã hóa nội dung hiện tại.

    Ctrl + B
        Giải mã nội dung hiện tại.

    Ctrl + R
        Thoát khỏi chương trình.

    Enter
        Xuống dòng.

    Backspace
        Xóa ký tự cuối.

    Ctrl + C
        Thoát an toàn.

Đặc điểm:

    - Không dùng thư viện bên ngoài.
    - Dùng termios / tty của Python trên Unix.
    - Hỗ trợ UTF-8.
    - Hỗ trợ văn bản nhiều dòng.
    - Có key.
    - Có kiểm tra tính hợp lệ của key.
    - Có kiểm tra dữ liệu sau giải mã.
    - Có giao diện terminal.
    - Tự khôi phục trạng thái terminal khi thoát.
"""

import sys
import os
import tty
import termios
import getpass
import hashlib
import hmac
import secrets
import base64


# ============================================================
# CẤU HÌNH
# ============================================================

PROGRAM_NAME = "MC CUSTOM CIPHER"

VERSION = "2.0"

HEADER = "MCX2."

KEY_DERIVATION_ROUNDS = 120_000

SALT_SIZE = 16

NONCE_SIZE = 16

TAG_SIZE = 32

KEY_SIZE = 32


# ============================================================
# ANSI TERMINAL
# ============================================================

ANSI_RESET = "\033[0m"

ANSI_BOLD = "\033[1m"

ANSI_DIM = "\033[2m"

