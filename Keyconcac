            "│" +
            ANSI_RESET +
            f"                    VERSION {VERSION}                        " +
            ANSI_CYAN +
            "│" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            "├────────────────────────────────────────────────────────────┤" +
            ANSI_RESET
        )

        print(
            ANSI_GRAY +
            "│ " +
            ANSI_RESET +
