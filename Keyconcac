class TextEditor:
    """
    Bộ nhập văn bản nhiều dòng.

    Các phím:

        Enter
            Xuống dòng.

        Backspace
            Xóa ký tự cuối.

        Ctrl+U
            Yêu cầu mã hóa.

        Ctrl+B
            Yêu cầu giải mã.

        Ctrl+R
            Thoát.

        Ctrl+C
            Thoát an toàn.
    """

    CTRL_U = 21

    CTRL_B = 2

    CTRL_R = 18

    CTRL_C = 3

    BACKSPACE = 127

    BACKSPACE_ALT = 8

    ENTER = 13

    LINE_FEED = 10

    def __init__(self):

        self.buffer = []

        self.cursor_position = 0

    def get_text(self):

        return "".join(
            self.buffer
        )

    def set_text(self, text):

        self.buffer = list(
            text
        )

        self.cursor_position = len(
            self.buffer
        )

    def append_character(self, character):

        self.buffer.insert(
            self.cursor_position,
            character
        )

        self.cursor_position += 1

    def backspace(self):

        if self.cursor_position <= 0:
            return

        self.cursor_position -= 1

        del self.buffer[
            self.cursor_position
        ]

    def move_left(self):

        if self.cursor_position > 0:

            self.cursor_position -= 1

    def move_right(self):

        if (
            self.cursor_position
            < len(self.buffer)
        ):

            self.cursor_position += 1

    def clear(self):

        self.buffer.clear()

        self.cursor_position = 0


