#!/usr/bin/env python3

import sys
import os
import tty
import termios
import getpass
import hashlib
import hmac
import secrets
import base64
import string
from pathlib import Path

PROGRAM_NAME = "MC CUSTOM CIPHER"
VERSION = "3.0"
HEADER = "MCX3."

KEY_DERIVATION_ROUNDS = 120_000
SALT_SIZE = 16
NONCE_SIZE = 16
TAG_SIZE = 32
KEY_SIZE = 32

ANSI_RESET = "\033[0m"
ANSI_BOLD = "\033[1m"
ANSI_DIM = "\033[2m"
ANSI_CYAN = "\033[96m"
ANSI_GREEN = "\033[92m"
ANSI_YELLOW = "\033[93m"
ANSI_RED = "\033[91m"
ANSI_GRAY = "\033[90m"
ANSI_CLEAR_SCREEN = "\033[2J"
ANSI_CURSOR_HOME = "\033[H"
ANSI_CURSOR_HIDE = "\033[?25l"
ANSI_CURSOR_SHOW = "\033[?25h"

CTRL_U = 21
CTRL_B = 2
CTRL_R = 18
CTRL_C = 3
BACKSPACE = 127
BACKSPACE_ALT = 8
ENTER = 13
LINE_FEED = 10


def terminal_write(text):
    sys.stdout.write(text)
    sys.stdout.flush()


def terminal_clear():
    terminal_write(
        ANSI_CLEAR_SCREEN +
        ANSI_CURSOR_HOME
    )


def terminal_hide_cursor():
    terminal_write(ANSI_CURSOR_HIDE)


def terminal_show_cursor():
    terminal_write(ANSI_CURSOR_SHOW)


class TerminalState:
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.original = None
        self.active = False

    def enter(self):
        if self.active:
            return

        self.original = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        self.active = True

    def restore(self):
        if not self.active:
            return

        if self.original is not None:
            termios.tcsetattr(
                self.fd,
                termios.TCSADRAIN,
                self.original
            )

        self.active = False

    def __enter__(self):
        self.enter()
        return self

    def __exit__(self, *args):
        self.restore()


def derive_key(password, salt):
    return hashlib.pbkdf2_hmac(
        "sha256",
        password.encode("utf-8"),
        salt,
        KEY_DERIVATION_ROUNDS,
        dklen=KEY_SIZE
    )


def generate_keystream(key, nonce, length):
    result = bytearray()
    counter = 0

    while len(result) < length:
        counter_bytes = counter.to_bytes(8, "big")

        block = hashlib.blake2s(
            key=key,
            digest_size=32,
            person=b"MCX3STRM",
            salt=nonce
        )

        block.update(counter_bytes)

        result.extend(block.digest())
        counter += 1

    return bytes(result[:length])


def xor_bytes(data, stream):
    return bytes(
        a ^ b
        for a, b in zip(data, stream)
    )


def create_tag(key, salt, nonce, ciphertext):
    message = (
        b"MCX3|" +
        salt +
        nonce +
        ciphertext
    )

    return hmac.new(
        key,
        message,
        hashlib.sha256
    ).digest()


def encrypt_text(text, password):
    if not password:
        raise ValueError("Key không được để trống.")

    plaintext = text.encode("utf-8")

    salt = secrets.token_bytes(SALT_SIZE)
    nonce = secrets.token_bytes(NONCE_SIZE)

    key = derive_key(password, salt)

    stream = generate_keystream(
        key,
        nonce,
        len(plaintext)
    )

    ciphertext = xor_bytes(
        plaintext,
        stream
    )

    tag = create_tag(
        key,
        salt,
        nonce,
        ciphertext
    )

    payload = (
        salt +
        nonce +
        ciphertext +
        tag
    )

    encoded = base64.urlsafe_b64encode(
        payload
    ).decode("ascii").rstrip("=")

    return HEADER + encoded


def decrypt_text(data, password):
    if not password:
        raise ValueError("Key không được để trống.")

    data = data.strip()

    if not data.startswith(HEADER):
        raise ValueError(
            "Dữ liệu không bắt đầu bằng MCX3."
        )

    encoded = data[len(HEADER):]

    encoded += "=" * (
        (4 - len(encoded) % 4) % 4
    )

    try:
        payload = base64.urlsafe_b64decode(encoded)
    except Exception:
        raise ValueError(
            "Chuỗi MCX3 bị hỏng."
        )

    minimum = (
        SALT_SIZE +
        NONCE_SIZE +
        TAG_SIZE
    )

    if len(payload) < minimum:
        raise ValueError(
            "Dữ liệu MCX3 quá ngắn."
        )

    salt = payload[:SALT_SIZE]

    nonce_start = SALT_SIZE
    nonce_end = nonce_start + NONCE_SIZE

    nonce = payload[
        nonce_start:nonce_end
    ]

    tag_start = len(payload) - TAG_SIZE

    ciphertext = payload[
        nonce_end:tag_start
    ]

    received_tag = payload[tag_start:]

    key = derive_key(
        password,
        salt
    )

    expected_tag = create_tag(
        key,
        salt,
        nonce,
        ciphertext
    )

    if not hmac.compare_digest(
        received_tag,
        expected_tag
    ):
        raise ValueError(
            "Sai key hoặc dữ liệu đã bị thay đổi."
        )

    stream = generate_keystream(
        key,
        nonce,
        len(ciphertext)
    )

    plaintext = xor_bytes(
        ciphertext,
        stream
    )

    try:
        return plaintext.decode("utf-8")
    except UnicodeDecodeError:
        raise ValueError(
            "Dữ liệu giải mã không phải UTF-8 hợp lệ."
        )


def get_download_directory():
    paths = [
        Path.home() / "storage" / "downloads",
        Path("/sdcard/Download"),
        Path("/sdcard/Downloads"),
        Path("/storage/emulated/0/Download"),
        Path("/storage/emulated/0/Downloads")
    ]

    for path in paths:
        try:
            if path.exists() and path.is_dir():
                return path
        except Exception:
            pass

    fallback = Path.cwd() / "Download"
    fallback.mkdir(
        parents=True,
        exist_ok=True
    )

    return fallback


def sanitize_key_for_filename(key):
    allowed = (
        string.ascii_letters +
        string.digits +
        "-."
    )

    result = ""

    for char in key:
        if char in allowed:
            result += char
        else:
            result += "_"

    result = result.strip(".")

    if not result:
        result = "KEY"

    return result[:80]


def random_filename(key):
    random_id = secrets.token_hex(10)
    safe_key = sanitize_key_for_filename(key)

    return (
        f"MCX3_{random_id}_KEY_{safe_key}.mcx"
    )


def save_encrypted(encrypted, key):
    directory = get_download_directory()

    for _ in range(100):
        filename = random_filename(key)
        path = directory / filename

        if not path.exists():
            path.write_text(
                encrypted,
                encoding="utf-8"
            )

            return path

    raise RuntimeError(
        "Không tạo được tên file ngẫu nhiên."
    )


def save_decrypted(text):
    directory = get_download_directory()

    random_id = secrets.token_hex(10)

    path = directory / (
        f"MCX3_DECRYPTED_{random_id}.txt"
    )

    path.write_text(
        text,
        encoding="utf-8"
    )

    return path


class TextEditor:
    def __init__(self):
        self.buffer = []
        self.cursor = 0

    def text(self):
        return "".join(self.buffer)

    def add(self, char):
        self.buffer.insert(
            self.cursor,
            char
        )
        self.cursor += 1

    def backspace(self):
        if self.cursor > 0:
            self.cursor -= 1
            del self.buffer[self.cursor]


