            ANSI_RESET
        )

        print(
            ANSI_GRAY +
            "│ " +
            ANSI_RESET +
            "Enter xuống dòng   Backspace xóa ký tự" +
            ANSI_GRAY +
            "              │" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            "├────────────────────────────────────────────────────────────┤" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
