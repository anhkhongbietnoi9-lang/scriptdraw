# ============================================================
# HÀM IN AN TOÀN
# ============================================================

def terminal_write(text):
    """
    Ghi trực tiếp ra terminal.

    Используем flush для немедленного вывода.
    """

    sys.stdout.write(text)

    sys.stdout.flush()


def terminal_clear():
    """
    Xóa toàn bộ terminal và đưa con trỏ về đầu.
    """

    terminal_write(
        ANSI_CLEAR_SCREEN +
        ANSI_CURSOR_HOME
    )


def terminal_hide_cursor():
    """
    Ẩn con trỏ.
    """

    terminal_write(
        ANSI_CURSOR_HIDE
    )


def terminal_show_cursor():
    """
    Hiện lại con trỏ.
    """

    terminal_write(
        ANSI_CURSOR_SHOW
    )


# ============================================================
# TRẠNG THÁI TERMINAL
# ============================================================

class TerminalState:
    """
    Quản lý trạng thái terminal.

    Сохраняем исходные настройки терминала,
    чтобы после завершения программы восстановить их.
    """

    def __init__(self):

        self.file_descriptor = sys.stdin.fileno()

        self.original_attributes = None

        self.is_active = False

    def enter(self):

        if self.is_active:
            return

        self.original_attributes = (
            termios.tcgetattr(
                self.file_descriptor
            )
        )

        tty.setcbreak(
            self.file_descriptor
        )

        self.is_active = True

    def restore(self):

        if not self.is_active:
            return

        if self.original_attributes is not None:

            termios.tcsetattr(
                self.file_descriptor,
                termios.TCSADRAIN,
                self.original_attributes
            )

        self.is_active = False

    def __enter__(self):

        self.enter()

        return self

    def __exit__(
        self,
        exception_type,
        exception_value,
        traceback
    ):

        self.restore()


# ============================================================
# KEY
# ============================================================

def derive_key(password, salt):
    """
    Tạo khóa nhị phân từ key người dùng.

    Sử dụng PBKDF2-HMAC-SHA256.
    """

    password_bytes = password.encode(
        "utf-8"
    )

    derived_key = hashlib.pbkdf2_hmac(
        "sha256",
        password_bytes,
        salt,
        KEY_DERIVATION_ROUNDS,
        dklen=KEY_SIZE
    )

    return derived_key


# ============================================================
# STREAM KEY
# ============================================================

def generate_keystream(key, nonce, length):
    """
    Tạo chuỗi byte dùng để XOR.

    Đây là phần cấu trúc tự thiết kế của MCX2.

    Lưu ý:

        Đây không phải stream cipher tiêu chuẩn.
        Nó chỉ phục vụ cho định dạng tự chế này.
    """

    result = bytearray()

    counter = 0

    while len(result) < length:

        counter_bytes = counter.to_bytes(
            8,
            byteorder="big"
        )

        block = hashlib.blake2s(
            key=key,
            digest_size=32,
            person=b"MCX2STREAM",
            salt=nonce
        ).copy()

        block.update(counter_bytes)

        result.extend(
            block.digest()
        )

        counter += 1

    return bytes(
        result[:length]
    )


# ============================================================
# XOR
# ============================================================

def xor_bytes(data, keystream):
    """
    XOR dữ liệu với keystream.
    """

    result = bytearray(
        len(data)
    )

    for index in range(len(data)):

        result[index] = (
            data[index] ^
            keystream[index]
        )

    return bytes(result)


# ============================================================
# AUTH TAG
# ============================================================

def create_authentication_tag(
    key,
    salt,
    nonce,
    ciphertext
):
    """
    Tạo tag kiểm tra dữ liệu.

    HMAC-SHA256 giúp phát hiện:

        - sai key
        - dữ liệu bị sửa
        - mã bị thiếu
        - mã bị hỏng
    """

    message = (
        b"MCX2|" +
        salt +
        nonce +
        ciphertext
    )

    return hmac.new(
        key,
        message,
        hashlib.sha256
    ).digest()


# ============================================================
# MÃ HÓA
# ============================================================

def encrypt_text(text, password):
    """
    Mã hóa văn bản thành chuỗi MCX2.
    """

    if password == "":
        raise ValueError(
            "Key không được để trống."
        )

    plaintext = text.encode(
        "utf-8"
    )

    salt = secrets.token_bytes(
        SALT_SIZE
    )

    nonce = secrets.token_bytes(
        NONCE_SIZE
    )

    key = derive_key(
        password,
        salt
    )

    keystream = generate_keystream(
        key,
        nonce,
        len(plaintext)
    )

    ciphertext = xor_bytes(
        plaintext,
        keystream
    )

    tag = create_authentication_tag(
        key,
        salt,
        nonce,
        ciphertext
    )

    payload = (
        salt +
        nonce +
        ciphertext +
        tag
    )

    encoded = base64.urlsafe_b64encode(
        payload
    ).decode(
        "ascii"
    ).rstrip("=")

    return HEADER + encoded


# ============================================================
# GIẢI MÃ
# ============================================================

def decrypt_text(encoded_text, password):
    """
    Giải mã chuỗi MCX2.
    """

    if password == "":
        raise ValueError(
            "Key không được để trống."
        )

    if not encoded_text.startswith(
        HEADER
    ):
        raise ValueError(
            "Dữ liệu không bắt đầu bằng MCX2."
        )

    encoded_payload = (
        encoded_text[
            len(HEADER):
        ]
        .strip()
    )

    padding_length = (
        4 -
        len(encoded_payload) % 4
    ) % 4

    encoded_payload += (
        "=" * padding_length
    )

    try:

        payload = (
            base64.urlsafe_b64decode(
                encoded_payload
            )
        )

    except Exception as error:

        raise ValueError(
            "Chuỗi MCX2 bị hỏng."
        ) from error

    minimum_size = (
        SALT_SIZE +
        NONCE_SIZE +
        TAG_SIZE
    )

    if len(payload) < minimum_size:

        raise ValueError(
            "Dữ liệu MCX2 quá ngắn."
        )

    salt = payload[
        0:SALT_SIZE
    ]

    nonce_start = SALT_SIZE

    nonce_end = (
        nonce_start +
        NONCE_SIZE
    )

    nonce = payload[
        nonce_start:nonce_end
    ]

    tag_start = len(payload) - TAG_SIZE

    ciphertext = payload[
        nonce_end:tag_start
    ]

    received_tag = payload[
        tag_start:
    ]

    key = derive_key(
        password,
        salt
    )

    expected_tag = (
        create_authentication_tag(
            key,
            salt,
            nonce,
            ciphertext
        )
    )

    if not hmac.compare_digest(
        received_tag,
        expected_tag
    ):

        raise ValueError(
            "Sai key hoặc dữ liệu đã bị thay đổi."
        )

    keystream = generate_keystream(
        key,
        nonce,
        len(ciphertext)
    )

    plaintext = xor_bytes(
        ciphertext,
        keystream
    )

    try:

        return plaintext.decode(
            "utf-8"
        )

    except UnicodeDecodeError as error:

        raise ValueError(
            "Dữ liệu giải mã không phải UTF-8 hợp lệ."
        ) from error


