def ask_for_key():
    """
    Nhập key bằng getpass để không hiện key trên màn hình.
    """

    terminal_show_cursor()

    print()

    print(
        ANSI_CYAN +
        "KEY" +
        ANSI_RESET
    )

    print(
        ANSI_DIM +
        "Key sẽ không được hiển thị." +
        ANSI_RESET
    )

    password = getpass.getpass(
        "Nhập KEY: "
    )

    if password == "":

        raise ValueError(
            "Key không được để trống."
        )

    return password


