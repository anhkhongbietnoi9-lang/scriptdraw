class UserInterface:

    def __init__(self):

        self.status_text = "READY"

        self.status_type = "normal"

    def set_status(
        self,
        message,
        status_type="normal"
    ):

        self.status_text = message

        self.status_type = (
            status_type
        )

    def draw_header(self):

        terminal_clear()

        print(
            ANSI_CYAN +
            ANSI_BOLD +
            "╭────────────────────────────────────────────────────────────╮" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            ANSI_BOLD +
            "│" +
            ANSI_RESET +
            "                  MC CUSTOM CIPHER                       " +
            ANSI_CYAN +
            ANSI_BOLD +
            "│" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            "│" +
            ANSI_RESET +
            "                  TERMINAL EDITOR                        " +
            ANSI_CYAN +
            "│" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            "├────────────────────────────────────────────────────────────┤" +
            ANSI_RESET
        )

    def draw_help(self):

        print(
            ANSI_GRAY +
            "│ " +
            ANSI_RESET +
            "Ctrl+U  Mã hóa    "
            "Ctrl+B  Giải mã    "
            "Ctrl+R  Thoát" +
            ANSI_GRAY +
            "                    │" +
            ANSI_RESET
        )

        print(
            ANSI_GRAY +
            "│ " +
            ANSI_RESET +
            "Enter xuống dòng    "
            "Backspace xóa ký tự" +
            ANSI_GRAY +
            "                    │" +
            ANSI_RESET
        )

        print(
            ANSI_CYAN +
            "├────────────────────────────────────────────────────────────┤" +
            ANSI_RESET
        )

    def get_status_color(self):

        if self.status_type == "success":

            return ANSI_GREEN

        if self.status_type == "error":

            return ANSI_RED

        if self.status_type == "warning":

            return ANSI_YELLOW

        return ANSI_WHITE

    def draw_status(
        self,
        text,
        key,
        mode
    ):

        color = self.get_status_color()

        character_count = len(text)

        byte_count = len(
            text.encode(
                "utf-8"
            )
        )

        key_mask = (
            "*" * len(key)
        )

        print(
            ANSI_CYAN +
            "│ " +
            ANSI_RESET +
            f"KEY    : {key_mask}" +
            "\n"
        )

        print(
            ANSI_CYAN +
            "│ " +
            ANSI_RESET +
            f"MODE   : {mode}"
        )

        print()

        print(
            ANSI_CYAN +
            "│ " +
            ANSI_RESET +
            f"CHARS  : {character_count}"
        )

        print()

        print(
            ANSI_CYAN +
            "│ " +
            ANSI_RESET +
            f"BYTES  : {byte_count}"
        )

        print()

        print(
            ANSI_CYAN +
            "│ " +
            ANSI_RESET +
            "STATUS : " +
            color +
            self.status_text +
            ANSI_RESET
        )

        print()

        print(
            ANSI_CYAN +
            "╰────────────────────────────────────────────────────────────╯" +
            ANSI_RESET
        )


# ============================================================
# VẼ EDITOR
# ============================================================

def render_editor(
    user_interface,
    editor,
    key,
    mode
):
    """
    Vẽ lại giao diện.

    Không cố làm giao diện màu mè.
    Chỉ hiển thị thông tin thực sự hữu ích.
    """

    user_interface.draw_header()

    user_interface.draw_help()

    text = editor.get_text()

    lines = text.split(
        "\n"
    )

    print(
        ANSI_CYAN +
        "│ " +
        ANSI_RESET +
        "NỘI DUNG" 
    )

    print(
        ANSI_CYAN +
        "│ " +
        ANSI_RESET +
        "────────────────────────────────────────────────────────────"
    )

    if not lines:

        print(
            ANSI_GRAY +
            "│ " +
            ANSI_RESET +
            "..."
        )

    else:

        for line_index, line in enumerate(
            lines,
            start=1
        ):

            print(
                ANSI_CYAN +
                "│ " +
                ANSI_RESET +
                f"{line_index:03d} │ {line}"
            )

    print(
        ANSI_CYAN +
        "├────────────────────────────────────────────────────────────┤" +
        ANSI_RESET
    )

    user_interface.draw_status(
        text,
        key,
        mode
    )


# ============================================================
# NHẬN PHÍM
# ============================================================

def read_character():
    """
    Đọc một ký tự từ terminal.

    tty cbreak cho phép chương trình nhận phím
    mà không cần chờ Enter.
    """

    character = sys.stdin.read(
        1
    )

    return character


# ============================================================
# CHỜ PHÍM
# ============================================================

def input_loop(
    editor,
    user_interface,
    key
):
    """
    Vòng lặp chính.

    Trả về:

        "encrypt"
        "decrypt"
        "exit"
    """

    with TerminalState():

        terminal_hide_cursor()

        render_editor(
            user_interface,
            editor,
            key,
            "INPUT"
        )

        while True:

            character = read_character()

            if character == "":

                return "exit"

            code = ord(
                character
            )

            # ------------------------------------------------
            # CTRL + R
            # ------------------------------------------------

            if code == TextEditor.CTRL_R:

                return "exit"

            # ------------------------------------------------
            # CTRL + C
            # ------------------------------------------------

            if code == TextEditor.CTRL_C:

                return "exit"

            # ------------------------------------------------
            # CTRL + U
            # ------------------------------------------------

            if code == TextEditor.CTRL_U:

                return "encrypt"

            # ------------------------------------------------
            # CTRL + B
            # ------------------------------------------------

            if code == TextEditor.CTRL_B:

                return "decrypt"

            # ------------------------------------------------
            # BACKSPACE
            # ------------------------------------------------

            if (
                code ==
                TextEditor.BACKSPACE
                or
                code ==
                TextEditor.BACKSPACE_ALT
            ):

                editor.backspace()

                render_editor(
                    user_interface,
                    editor,
                    key,
                    "INPUT"
                )

                continue

            # ------------------------------------------------
            # ENTER
            # ------------------------------------------------

            if (
                code ==
                TextEditor.ENTER
                or
                code ==
                TextEditor.LINE_FEED
            ):

                editor.append_character(
                    "\n"
                )

                render_editor(
                    user_interface,
                    editor,
                    key,
                    "INPUT"
                )

                continue

            # ------------------------------------------------
            # KÝ TỰ BÌNH THƯỜNG
            # ------------------------------------------------

            if (
                character.isprintable()
                or
                code >= 128
            ):

                editor.append_character(
                    character
                )

                render_editor(
                    user_interface,
                    editor,
                    key,
                    "INPUT"
                )


# ============================================================
# CHẠY MỘT PHIÊN
# ============================================================

def process_session(
    key
):
    """
    Chạy một phiên nhập / mã hóa / giải mã.
    """

    editor = TextEditor()

    interface = UserInterface()

    action = input_loop(
        editor,
        interface,
        key
    )

    if action == "exit":

        return (
            False,
            ""
        )

    text = editor.get_text()

    if text == "":

        terminal_show_cursor()

        print()

        print(
            ANSI_YELLOW +
            "Không có nội dung." +
            ANSI_RESET
        )

        return (
            True,
            ""
        )

    try:

        if action == "encrypt":

            result = encrypt_text(
                text,
                key
            )

            terminal_show_cursor()

            print()

            print(
                ANSI_GREEN +
                ANSI_BOLD +
                "══════════════ MÃ HÓA ══════════════" +
                ANSI_RESET
            )

            print()

            print(result)

            print()

            print(
                ANSI_GREEN +
                "═════════════════════════════════════" +
                ANSI_RESET
            )

            print()

            return (
                True,
                result
            )

        if action == "decrypt":

            result = decrypt_text(
                text,
                key
            )

            terminal_show_cursor()

            print()

            print(
                ANSI_GREEN +
                ANSI_BOLD +
                "══════════════ GIẢI MÃ ══════════════" +
                ANSI_RESET
            )

            print()

            print(result)

            print()

            print(
                ANSI_GREEN +
                "═════════════════════════════════════" +
                ANSI_RESET
            )

            print()

            return (
                True,
                result
            )

    except Exception as error:

        terminal_show_cursor()

        print()

        print(
            ANSI_RED +
            "LỖI: " +
            ANSI_RESET +
            str(error)
        )

        print()

        return (
            True,
            ""
        )

    return (
        True,
        ""
    )


# ============================================================
# MAIN
# ============================================================

def main():

    try:

        terminal_clear()

        terminal_show_cursor()

        print(
            ANSI_CYAN +
            ANSI_BOLD +
            "MC CUSTOM CIPHER " +
            VERSION +
            ANSI_RESET
        )

        print()

        print(
            ANSI_GRAY +
            "Custom terminal cipher / UTF-8 / MCX2" +
            ANSI_RESET
        )

        print()

        key = ask_for_key()

        print()

        print(
            ANSI_GREEN +
            "Key đã được nhận." +
            ANSI_RESET
        )

        print()

        print(
            ANSI_GRAY +
            "Bắt đầu bộ soạn thảo..." +
            ANSI_RESET
        )

        print()

        while True:

            keep_running, result = (
                process_session(
                    key
                )
            )

            if not keep_running:

                break

            print(
                ANSI_GRAY +
                "Ctrl+U = mã hóa | "
                "Ctrl+B = giải mã | "
                "Ctrl+R = thoát" +
                ANSI_RESET
            )

            print()

            input(
                "Nhấn Enter để quay lại..."
            )

            terminal_clear()

    except KeyboardInterrupt:

        pass

    except EOFError:

        pass

    except Exception as error:

        terminal_show_cursor()

        print()

        print(
            ANSI_RED +
            "Lỗi nghiêm trọng: " +
            ANSI_RESET +
            str(error)
        )

    finally:

        terminal_show_cursor()

        terminal_clear()

        print(
            ANSI_CYAN +
            "MC CUSTOM CIPHER" +
            ANSI_RESET
        )

        print(
            ANSI_GREEN +
            "Đã thoát an toàn." +
            ANSI_RESET
        )

        print()


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":

    main()
