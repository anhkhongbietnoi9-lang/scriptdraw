# ============================================================
# HTTP SERVER
# ============================================================

class Handler(
    BaseHTTPRequestHandler
):

    server_version = (
        "SORecon/2.0"
    )

    def log_message(
        self,
        format_string,
        *args
    ):

        print(
            "[web] "
            + (
                format_string
                % args
            ),
            flush=True,
        )

    # --------------------------------------------------------

    def send_bytes(
        self,
        status_code,
        data,
        content_type="text/plain; charset=utf-8",
        headers=None,
    ):

        self.send_response(
            status_code
        )

        self.send_header(
            "Content-Type",
            content_type
        )

        self.send_header(
            "Content-Length",
            str(len(data))
        )

        self.send_header(
            "Cache-Control",
            "no-store"
        )

        if headers:

            for key, value in headers.items():

                self.send_header(
                    key,
                    value
                )

        self.end_headers()

        try:

            self.wfile.write(
                data
            )

        except BrokenPipeError:
            pass

    # --------------------------------------------------------

    def send_json(
        self,
        data,
        status_code=200,
    ):

        payload = json.dumps(
            data,
            ensure_ascii=False,
        ).encode(
            "utf-8"
        )

        self.send_bytes(
            status_code,
            payload,
            "application/json; charset=utf-8",
        )

    # --------------------------------------------------------

    def do_GET(self):

        path = urlparse(
            self.path
        ).path

        if path in (
            "/",
            "/index.html",
        ):

            self.send_bytes(
                200,
                INDEX_HTML.encode(
                    "utf-8"
                ),
                "text/html; charset=utf-8",
            )

            return


        if path.startswith(
            "/download/"
        ):

            job_id = path.split(
                "/",
                2
            )[-1]

            safe_job = "".join(
                character
                for character in job_id
                if (
                    character.isalnum()
                    or character in "_-"
                )
            )

            if not safe_job:
                self.send_bytes(
                    400,
                    b"Invalid job id"
                )
                return

            path = os.path.join(
                OUTPUT_DIR,
                safe_job + ".txt",
            )

            if not os.path.isfile(
                path
            ):

                self.send_bytes(
                    404,
                    b"File not found"
                )

                return

            try:

                with open(
                    path,
                    "rb"
                ) as file:

                    data = file.read()

                self.send_bytes(
                    200,
                    data,
                    "text/plain; charset=utf-8",
                    {
                        "Content-Disposition":
                            'attachment; '
                            'filename="decompiled_logic.txt"'
                    },
                )

            except Exception as error:

                self.send_bytes(
                    500,
                    str(error).encode()
                )

            return


        self.send_bytes(
            404,
            b"Not found"
        )

    # --------------------------------------------------------

    def do_POST(self):

        path = urlparse(
            self.path
        ).path

        if path != "/analyze":

            self.send_bytes(
                404,
                b"Not found"
            )

            return


        try:

            content_length = int(
                self.headers.get(
                    "Content-Length",
                    "0"
                )
            )

        except ValueError:

            self.send_bytes(
                400,
                b"Invalid Content-Length"
            )

            return


        if (
            content_length <= 0
            or content_length > MAX_UPLOAD_SIZE
        ):

            self.send_bytes(
                413,
                b"Upload too large"
            )

            return


        content_type = self.headers.get(
            "Content-Type",
            ""
        )


        if not content_type.startswith(
            "multipart/form-data"
        ):

            self.send_bytes(
                400,
                b"Expected multipart/form-data"
            )

            return


        try:

            body = self.rfile.read(
                content_length
            )

            # ------------------------------------------------
            # Parse multipart bằng parser chuẩn Python
            # ------------------------------------------------

            header_blob = (
                b"Content-Type: "
                + content_type.encode()
                + b"\r\n"
                + b"\r\n"
            )

            message = (
                BytesParser(
                    policy=default
                ).parsebytes(
                    header_blob
                    + body
                )
            )

            file_bytes = None
            original_name = "uploaded.so"

            if not message.is_multipart():

                raise ValueError(
                    "Invalid multipart request"
                )

            for part in message.iter_parts():

                disposition = (
                    part.get(
                        "Content-Disposition",
                        ""
                    )
                )

                if (
                    'name="file"'
                    not in disposition
                ):
                    continue

                file_bytes = (
                    part.get_payload(
                        decode=True
                    )
                )

                filename = (
                    part.get_filename()
                )

                if filename:
                    original_name = (
                        os.path.basename(
                            filename
                        )
                    )

                break


            if not file_bytes:

                raise ValueError(
                    "No file uploaded"
                )


            if len(file_bytes) > MAX_UPLOAD_SIZE:

                raise ValueError(
                    "Uploaded file is too large"
                )


            if file_bytes[:4] != (
                b"\x7fELF"
            ):

                self.send_json(
                    {
                        "ok": False,
                        "error":
                            "Uploaded file is "
                            "not an ELF binary.",
                    }
                )

                return


            # ------------------------------------------------
            # Job ID
            # ------------------------------------------------

            job_id = hashlib.sha256(
                file_bytes
                + str(
                    time.time_ns()
                ).encode()
            ).hexdigest()[:16]


            filename = (
                job_id
                + "_"
                + original_name
            )

            filename = filename.replace(
                "/",
                "_"
            ).replace(
                "\\",
                "_"
            )

            uploaded_path = os.path.join(
                UPLOAD_DIR,
                filename
            )


            with open(
                uploaded_path,
                "wb"
            ) as file:

                file.write(
                    file_bytes
                )


            # ------------------------------------------------
            # Analyze
            # ------------------------------------------------

            result = analyze_so(
                uploaded_path,
                job_id
            )

            self.send_json(
                result
            )

        except Exception as error:

            traceback.print_exc()

            self.send_json(
                {
                    "ok": False,
                    "error":
                        str(error),
                },
                500,
            )


