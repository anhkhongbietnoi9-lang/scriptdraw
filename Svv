def port_available(port):
    sock = socket.socket(
        socket.AF_INET,
        socket.SOCK_STREAM,
    )

    try:
        sock.setsockopt(
            socket.SOL_SOCKET,
            socket.SO_REUSEADDR,
            1,
        )

        sock.bind((HOST, port))
        return True

    except OSError:
        return False

    finally:
        sock.close()


def find_free_port(start_port):
    for port in range(start_port, start_port + 100):
        if port_available(port):
            return port

    return None


