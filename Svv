        f"{os.path.basename(path)}"
    )

    lines.append(
        f"Job          : {job_id}"
    )

    lines.append(
        f"SHA256       : "
        f"{sha256_file(path)}"
    )

    lines.append("")

    # --------------------------------------------------------
    # ELF
    # --------------------------------------------------------

    lines.append(
        "--- ELF INFORMATION ---"
    )

    lines.append(
        f"Architecture : {analyzer.arch}"
    )

    lines.append(
        f"Bits         : {analyzer.bits}"
    )

    lines.append(
        f"Endian       : "
        f"{'little' if analyzer.endian == '<' else 'big'}"
    )

    lines.append("")

    # --------------------------------------------------------
    # WARNINGS
    # --------------------------------------------------------

    if analyzer.warnings:

        lines.append(
            "--- WARNINGS ---"
        )

        for warning in analyzer.warnings:

            lines.append(
                f"- {warning}"
            )

        lines.append("")

    # --------------------------------------------------------
    # SECTIONS
    # --------------------------------------------------------

    lines.append(
        "--- SECTIONS ---"
    )

    for section in analyzer.sections:

        lines.append(
            f"{section['name']:<25} "
            f"type={section['type']:<15} "
            f"addr=0x{section['address']:x} "
            f"size=0x{section['size']:x}"
        )

    lines.append("")

    # --------------------------------------------------------
    # STRINGS
    # --------------------------------------------------------

    lines.append(
        "--- STRINGS ---"
    )

    lines.append(
        f"Total strings: "
        f"{len(analyzer.strings)}"
    )

    for item in analyzer.strings[:500]:

        lines.append(
            f"0x{item['offset']:08x}: "
            f"{item['value']}"
        )

    if len(analyzer.strings) > 500:

        lines.append(
            f"... "
            f"{len(analyzer.strings) - 500} "
            f"more strings omitted"
        )

    lines.append("")

    # --------------------------------------------------------
    # FUNCTIONS
    # --------------------------------------------------------

    lines.append(
        "--- FUNCTIONS ---"
    )

    lines.append(
        f"Total functions: "
        f"{len(analyzer.functions)}"
    )

    for function in analyzer.functions:

        lines.append(
            f"{function['name']:<45} "
            f"0x{function['addr']:x} "
            f"size=0x{function['size']:x} "
            f"[{function['source']}]"
        )

    if not analyzer.functions:

        lines.append(
            "No STT_FUNC symbols found."
        )

        lines.append(
            "Function recovery from raw code is "
            "not automatically assumed."
        )

    lines.append("")

    # --------------------------------------------------------
    # RECONSTRUCTION
    # --------------------------------------------------------

    lines.append(
        "=" * 70
    )

    lines.append(
        "RECONSTRUCTED LOGIC"
    )

    lines.append(
        "=" * 70
    )

    if analyzer.functions:

        reconstructor = (
            LogicReconstructor(
                analyzer
            )
        )

        reconstructed = (
            reconstructor.reconstruct_all()
        )

        lines.append(
            reconstructed
        )

    else:

        lines.append(
            "// No reliable function boundaries."
        )

        lines.append(
            "// Logic reconstruction skipped."
        )

    # --------------------------------------------------------
    # FOOTER
    # --------------------------------------------------------

    elapsed = (
        time.time()
        - start_time
    )

    lines.append("")

    lines.append(
        "=" * 70
    )

    lines.append(
        f"Analysis finished in "
        f"{elapsed:.2f}s"
    )

    lines.append(
        "Unknown operations are intentionally "
        "not guessed."
    )

    lines.append(
        "by MC_meme_edit"
    )

    lines.append(
        "=" * 70
    )

    text = "\n".join(lines)

    # --------------------------------------------------------
    # SAVE
    # --------------------------------------------------------

    output_path = os.path.join(
        OUTPUT_DIR,
        f"{job_id}.txt",
    )

    with open(
        output_path,
        "w",
        encoding="utf-8",
    ) as file:

        file.write(text)

    return {
        "ok": True,
        "job_id": job_id,
        "arch": analyzer.arch,
        "bits": analyzer.bits,
        "functions": len(
            analyzer.functions
        ),
        "strings": len(
            analyzer.strings
        ),
        "warnings": analyzer.warnings,
        "text": text,
        "download": (
            f"/download/{job_id}"
        ),
    }


