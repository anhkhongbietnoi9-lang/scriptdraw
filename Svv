    <div class="status" id="status">Sẵn sàng.</div>
  </div>

  <div class="card hidden" id="resultCard">
    <h2>Decompiled Logic</h2>
    <div class="meta" id="meta"></div>
    <textarea id="editor" spellcheck="false"></textarea>
    <div class="row">
      <button class="secondary" id="copy">Copy</button>
      <button class="secondary" id="save">Save TXT</button>
      <button id="download">Download TXT</button>
    </div>
    <div class="status" id="dlStatus"></div>
  </div>

</main>
<script>
const $ = s => document.querySelector(s);
const fileInput = $("#file");
const btnRun = $("#run");
const bar = $("#bar");
const statusEl = $("#status");
const resultCard = $("#resultCard");
const editor = $("#editor");
const meta = $("#meta");
let currentText = "";
let currentJob = "";

fileInput.addEventListener("change", e => {
  const f = e.target.files[0];
  if (!f) return;
  $("#fileName").textContent = "📄 " + f.name;
  btnRun.disabled = false;
});

function setStatus(t, cls=""){
  statusEl.textContent = t;
  statusEl.className = "status " + cls;
}
function setBar(p){ bar.style.width = p + "%"; }

btnRun.addEventListener("click", async () => {
  const f = fileInput.files[0];
  if (!f) return;
  btnRun.disabled = true;
  resultCard.classList.add("hidden");
  setBar(0);
  setStatus("Đang upload...");

  const fd = new FormData();
  fd.append("file", f);

  try{
    setBar(5);
    const xhr = new XMLHttpRequest();
    const p = new Promise((res, rej) => {
      xhr.open("POST", "/analyze");
      xhr.upload.onprogress = e => {
        if (e.lengthComputable){
          setBar(5 + (e.loaded/e.total)*15);
        }
      };
      xhr.onload = () => res(xhr);
      xhr.onerror = () => rej(new Error("Network error"));
      xhr.send(fd);
    });
    setStatus("Đang phân tích ELF (có thể mất vài giây)...");
    setBar(25);
    const xhr = await p;
    setBar(100);
    if (xhr.status !== 200){
      setStatus("Lỗi: " + xhr.responseText, "err");
      btnRun.disabled = false;
      return;
    }
    const data = JSON.parse(xhr.responseText);
    if (!data.ok){
      setStatus("Lỗi: " + data.error, "err");
      btnRun.disabled = false;
      return;
    }
    currentText = data.text;
    currentJob = data.job_id;
    editor.value = currentText;
    meta.textContent =
      `Arch: ${data.arch} | Bits: ${data.bits} | ` +
      `Functions: ${data.num_functions} | Strings: ${data.num_strings}` +
      (data.warnings && data.warnings.length ? " | ⚠ " + data.warnings.join(" ") : "");
    resultCard.classList.remove("hidden");
    setStatus("Hoàn tất.", "");
  }catch(e){
    setStatus("Lỗi: " + e.message, "err");
  }finally{
    btnRun.disabled = false;
  }
});

$("#copy").addEventListener("click", async () => {
  try{
    await navigator.clipboard.writeText(editor.value);
    setStatus("Đã copy vào clipboard.");
  }catch(e){
    setStatus("Không copy được: " + e.message, "err");
  }
});

$("#save").addEventListener("click", () => {
  const blob = new Blob([editor.value], {type:"text/plain;charset=utf-8"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "decompiled_logic.txt";
  a.click();
  URL.revokeObjectURL(a.href);
});

$("#download").addEventListener("click", () => {
  if (!currentJob) return;
  window.location = "/download/" + currentJob;
});
</script>
</body>
</html>
"""

# ============================================================
# HTTP SERVER
# ============================================================
class Handler(BaseHTTPRequestHandler):
    server_version = "SORecon/1.0"

    def log_message(self, fmt, *args):
        # log gọn
        print(f"[web] {self.address_string()} - {fmt % args}", flush=True)

    def _send(self, code, body, ctype="text/plain; charset=utf-8", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        if extra:
            for k, v in extra.items():
                self.send_header(k, v)
        self.end_headers()
        try:
            self.wfile.write(body)
        except BrokenPipeError:
            pass

    def do_GET(self):
        path = urlparse(self.path).path

        if path == "/" or path == "/index.html":
            body = INDEX_HTML.encode("utf-8")
            self._send(200, body, "text/html; charset=utf-8")
            return

        if path.startswith("/download/"):
            job_id = path.rsplit("/", 1)[-1]
            job_id = "".join(c for c in job_id if c.isalnum() or c in "-_")
            fpath = os.path.join(OUTPUT_DIR, f"{job_id}.txt")
            if not os.path.isfile(fpath):
                self._send(404, b"Not found")
                return
            with open(fpath, "rb") as f:
                data = f.read()
            self._send(200, data, "text/plain; charset=utf-8", {
                "Content-Disposition": f'attachment; filename="decompiled_logic.txt"'
            })
            return

        self._send(404, b"Not found")

    def do_POST(self):
        path = urlparse(self.path).path
        if path != "/analyze":
            self._send(404, b"Not found")
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self._send(400, b"Bad length")
            return

        if length <= 0 or length > 200 * 1024 * 1024:
            self._send(400, b"Invalid size")
            return

        raw = self.rfile.read(length)
        boundary = None
        ctype = self.headers.get("Content-Type", "")
        if "boundary=" in ctype:
            boundary = ctype.split("boundary=", 1)[1].encode()
        if not boundary:
            self._send(400, b"No boundary")
            return

        # Parse multipart đơn giản
        parts = raw.split(b"--" + boundary)
        file_bytes = None
        for p in parts:
            if b'name="file"' in p:
                try:
                    header_end = p.index(b"\r\n\r\n") + 4
                except ValueError:
                    continue
                file_bytes = p[header_end:]
                # Cắt \r\n cuối
                if file_bytes.endswith(b"\r\n"):
                    file_bytes = file_bytes[:-2]
                break

        if not file_bytes:
            self._send(400, b"No file")
            return

        if file_bytes[:4] != b"\x7fELF":
            self._send(200, json.dumps({
                "ok": False,
                "error": "Invalid ELF file."
            }).encode("utf-8"), "application/json")
            return

        job_id = hashlib.md5(
            file_bytes + str(time.time()).encode()
        ).hexdigest()[:12]
        fname = f"{job_id}.so"
        fpath = os.path.join(UPLOAD_DIR, fname)
        with open(fpath, "wb") as f:
            f.write(file_bytes)

        try:
            result = analyze_so(fpath, job_id)
            self._send(200, json.dumps(result).encode("utf-8"),
                       "application/json")
        except Exception as e:
            tb = traceback.format_exc()
            print(tb, flush=True)
            self._send(500, json.dumps({
                "ok": False,
                "error": f"Internal error: {e}"
            }).encode("utf-8"), "application/json")

# ============================================================
# MỞ TRÌNH DUYỆT
# ============================================================
def open_browser(url):
    def _go():
        time.sleep(1.2)
        # Thử Termux API trước (ổn định nhất trên Android)
        opened = False
        if has_cmd("termux-open-url"):
            try:
                subprocess.run(["termux-open-url", url],
                               capture_output=True, timeout=10)
                opened = True
                log(f"Opened via termux-open-url: {url}")
            except Exception as e:
                log_err(f"termux-open-url failed: {e}")
        if not opened:
            try:
                opened = webbrowser.open(url)
                if opened:
                    log(f"Opened via webbrowser: {url}")
            except Exception as e:
                log_err(f"webbrowser failed: {e}")
        if not opened:
            log(f"Server started: {url}")
            log("(Không tự mở được trình duyệt. Hãy mở URL trên bằng tay.)")
    threading.Thread(target=_go, daemon=True).start()

# ============================================================
# MAIN
# ============================================================
def main():
    print("=" * 60)
    print(" SO LOGIC RECONSTRUCTOR")
    print("=" * 60)

    check_python()
    prepare_workspace()
    check_dependencies(auto_install=True)
    check_storage()

    if not check_port(PORT):
        # thử port khác
        global PORT
        for p in range(PORT + 1, PORT + 20):
            if check_port(p):
                PORT = p
                log(f"Using port {PORT} instead.")
                break
        else:
            log_err("No free port found.")
            sys.exit(1)

    log(f"Starting server on http://{HOST}:{PORT}")
    try:
        httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    except Exception as e:
        log_err(f"Cannot start server: {e}")
        sys.exit(1)

    url = f"http://{HOST}:{PORT}"
    log(f"Server ready: {url}")
    open_browser(url)

    def _stop(sig, frame):
        print()
        log("Shutting down...")
        try:
            httpd.shutdown()
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGINT, _stop)
    signal.signal(signal.SIGTERM, _stop)

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        _stop(None, None)

if __name__ == "__main__":
    main()
