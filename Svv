# LOGIC RECONSTRUCTOR
# ============================================================

class LogicReconstructor:

    CALL = {
        "call",
        "callq",
        "bl",
        "blx",
        "jal",
        "jalr",
        "blr",
    }

    RETURN = {
        "ret",
        "retq",
    }

    JUMP = {
        "jmp",
        "b",
        "br",
        "jr",
    }

    CONDITIONAL_JUMP = {
        "je",
        "jz",
        "jne",
        "jnz",
        "jg",
        "jge",
        "jl",
        "jle",
        "ja",
        "jae",
        "jb",
        "jbe",
        "js",
        "jns",
        "jo",
        "jno",
        "jp",
        "jnp",
        "jc",
        "jnc",
        "beq",
        "bne",
        "bgt",
        "bge",
        "blt",
        "ble",
        "bhi",
        "bls",
        "cbz",
        "cbnz",
        "tbz",
        "tbnz",
    }

    COMPARE = {
        "cmp",
        "cmn",
        "tst",
        "teq",
    }

    NOP = {
        "nop",
        "nop.w",
    }

    def __init__(self, analyzer):
        self.analyzer = analyzer

    # --------------------------------------------------------

    @staticmethod
    def instruction_text(instruction):

        mnemonic = instruction["mnemonic"]
        operands = instruction["op_str"]

        if operands:
            return f"{mnemonic} {operands}"

        return mnemonic

    # --------------------------------------------------------

    @staticmethod
    def label(address):
        return f"loc_{address:x}"

    # --------------------------------------------------------

    @staticmethod
    def target(instruction):

        operands = instruction["op_str"].strip()

        if not operands:
            return None

        token = operands.split(",", 1)[0].strip()

        try:

            if token.startswith("0x"):
                return int(token, 16)

            if token.startswith("-0x"):
                return -int(token[3:], 16)

        except ValueError:
            pass

        return None

    # --------------------------------------------------------

    def condition(self, mnemonic):

        table = {
            "je": "ZF == 1",
            "jz": "ZF == 1",
            "jne": "ZF == 0",
            "jnz": "ZF == 0",

            "jg": "ZF == 0 && SF == OF",
            "jge": "SF == OF",
            "jl": "SF != OF",
            "jle": "ZF == 1 || SF != OF",

            "ja": "CF == 0 && ZF == 0",
            "jae": "CF == 0",
            "jb": "CF == 1",
            "jbe": "CF == 1 || ZF == 1",

            "js": "SF == 1",
            "jns": "SF == 0",

            "jo": "OF == 1",
            "jno": "OF == 0",

            "jp": "PF == 1",
            "jnp": "PF == 0",

            "jc": "CF == 1",
            "jnc": "CF == 0",

            "beq": "condition == true",
            "bne": "condition == false",
            "bgt": "signed >",
            "bge": "signed >=",
            "blt": "signed <",
            "ble": "signed <=",

            "bhi": "unsigned >",
            "bls": "unsigned <=",

            "cbz": "register == 0",
            "cbnz": "register != 0",

            "tbz": "bit == 0",
            "tbnz": "bit != 0",
        }

        return table.get(
            mnemonic,
            "condition_unknown",
        )

    # --------------------------------------------------------

    def guess_arguments(self, instructions):

        if self.analyzer.arch == "x86_64":

            registers = [
                "rdi",
                "rsi",
                "rdx",
                "rcx",
                "r8",
                "r9",
            ]

        elif self.analyzer.arch == "x86":

            registers = [
                "eax",
                "ebx",
                "ecx",
                "edx",
            ]

        elif self.analyzer.arch == "ARM64":

            registers = [
                f"x{i}"
                for i in range(8)
            ]

        elif self.analyzer.arch == "ARM":

            registers = [
                f"r{i}"
                for i in range(4)
            ]

        else:
            return 0

        found = []

        for instruction in instructions[:80]:

            operands = (
                instruction["op_str"]
                .replace(",", " ")
                .split()
            )

            for register in registers:

                if register in operands:
                    if register not in found:
                        found.append(register)

        if not found:
            return 0

        highest = 0

        for register in found:

            try:

                if self.analyzer.arch == "x86_64":
                    index = registers.index(register)

                elif self.analyzer.arch == "ARM64":
                    index = int(register[1:])

                elif self.analyzer.arch == "ARM":
                    index = int(register[1:])

                else:
                    index = registers.index(register)

                highest = max(
                    highest,
                    index + 1,
                )

            except Exception:
                pass

        return min(highest, 8)

    # --------------------------------------------------------

    def reconstruct(self, function):

        name = function["name"]
        address = function["addr"]
        size = function["size"]

        instructions = (
            self.analyzer.disassemble_function(
                address,
                size,
            )
        )

        output = []

        output.append(
            f"// =================================================="
        )

        output.append(
            f"// FUNCTION: {name}"
        )

        output.append(
            f"// ADDRESS : 0x{address:x}"
        )

        output.append(
            f"// SIZE    : 0x{size:x}"
        )

        output.append(
            f"// ARCH    : {self.analyzer.arch}"
        )

        output.append(
            f"// SOURCE  : {function['source']}"
        )

        output.append(
            f"// =================================================="
        )

        if not instructions:

            output.append(
                "// UNKNOWN_OPERATION"
            )

            output.append(
                "// reason: unable to disassemble function"
            )

            return "\n".join(output)

        argument_count = (
            self.guess_arguments(
                instructions
            )
        )

        arguments = ", ".join(
            f"arg_{i}"
            for i in range(argument_count)
        )

        output.append(
            f"function_{address:x}({arguments}) {{"
        )

        for instruction in instructions:

            mnemonic = instruction[
                "mnemonic"
            ].lower()

            operands = instruction[
                "op_str"
            ]

            address_text = (
                f"0x{instruction['address']:x}"
            )

            raw = (
                self.instruction_text(
                    instruction
                )
            )

            if mnemonic in self.NOP:
                continue

            # ------------------------------------------------
            # RETURN
            # ------------------------------------------------

            if mnemonic in self.RETURN:

                output.append(
                    f"    return; "
                    f"// {address_text}: {raw}"
                )

                continue

            # ------------------------------------------------
            # CALL
            # ------------------------------------------------

            if mnemonic in self.CALL:

                target = self.target(
                    instruction
                )

                if target is not None:

                    output.append(
                        f"    call_0x{target:x}(); "
                        f"// {address_text}: {raw}"
                    )

                else:

                    output.append(
                        f"    UNKNOWN_CALL("
                        f"\"{raw}\""
                        f");"
                    )

                continue

            # ------------------------------------------------
            # CONDITIONAL BRANCH
            # ------------------------------------------------

            if mnemonic in self.CONDITIONAL_JUMP:

                target = self.target(
                    instruction
                )

                condition = self.condition(
                    mnemonic
                )

                if target is not None:

                    output.append(
                        f"    if ({condition}) "
                        f"goto "
                        f"{self.label(target)}; "
                        f"// {address_text}: {raw}"
                    )

                else:

                    output.append(
                        f"    UNKNOWN_BRANCH("
                        f"condition=\"{condition}\", "
                        f"raw=\"{raw}\""
                        f");"
                    )

                continue

            # ------------------------------------------------
            # UNCONDITIONAL BRANCH
            # ------------------------------------------------

            if mnemonic in self.JUMP:

                target = self.target(
                    instruction
                )

                if target is not None:

                    output.append(
                        f"    goto "
                        f"{self.label(target)}; "
                        f"// {address_text}: {raw}"
                    )

                else:

                    output.append(
                        f"    UNKNOWN_JUMP("
                        f"\"{raw}\""
                        f");"
                    )

                continue

            # ------------------------------------------------
            # COMPARE
            # ------------------------------------------------

            if mnemonic in self.COMPARE:

                output.append(
                    f"    // COMPARE: {raw}"
                )

                continue

            # ------------------------------------------------
            # EVERYTHING ELSE
            # ------------------------------------------------

            escaped = raw.replace(
                "\\",
                "\\\\",
            ).replace(
                "\"",
                "\\\"",
            )

            output.append(
                f"    UNKNOWN_OPERATION("
                f"address=0x{instruction['address']:x}, "
                f"raw=\"{escaped}\""
                f");"
            )

        output.append("}")

        return "\n".join(output)

    # --------------------------------------------------------

    def reconstruct_all(self):

        results = []

        for function in self.analyzer.functions:

            try:

                results.append(
                    self.reconstruct(
                        function
                    )
                )

            except Exception as error:

                results.append(
                    "\n".join([
                        f"// FUNCTION: "
                        f"{function['name']}",
                        f"// ADDRESS: "
                        f"0x{function['addr']:x}",
                        f"// UNKNOWN_OPERATION",
                        f"// reason: "
                        f"{error}",
                    ])
                )

        return "\n\n".join(results)


