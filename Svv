def open_browser(url):

    def worker():

        time.sleep(
            1.2
        )

        if has_command(
            "termux-open-url"
        ):

            try:

                subprocess.run(
                    [
                        "termux-open-url",
                        url,
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=10,
                )

                log(
                    f"Browser opened: {url}"
                )

                return

            except Exception:
                pass


        try:

            if webbrowser.open(url):

                log(
                    f"Browser opened: {url}"
                )

                return

        except Exception:
            pass


        log(
            f"Open manually: {url}"
        )


    threading.Thread(
        target=worker,
        daemon=True,
    ).start()


