# PHÂN TÍCH ELF
# ============================================================
class ELFAnalyzer:
    """Phân tích ELF thật, KHÔNG bịa. Nếu thiếu info -> đánh dấu UNKNOWN."""

    ARCH_MAP = {
        "EM_386": "x86",
        "EM_X86_64": "x86_64",
        "EM_ARM": "ARM",
        "EM_AARCH64": "ARM64",
        "EM_MIPS": "MIPS",
        "EM_RISCV": "RISC-V",
    }

    CAPSTONE_MODE = {
        "x86":     ("CS_ARCH_X86", "CS_MODE_32"),
        "x86_64":  ("CS_ARCH_X86", "CS_MODE_64"),
        "ARM":     ("CS_ARCH_ARM", "CS_MODE_ARM"),
        "ARM64":   ("CS_ARCH_ARM64", "CS_MODE_ARM"),
        "MIPS":    ("CS_ARCH_MIPS", "CS_MODE_MIPS32"),
        "RISC-V":  ("CS_ARCH_RISCV", "CS_MODE_RISCV64"),
    }

    def __init__(self, path):
        self.path = path
        self.elf = None
        self.arch = None
        self.bits = 64
        self.endian = "<"
        self.symbols = {}
        self.dynsyms = {}
        self.functions = []
        self.strings = []
        self.warnings = []

    def load(self):
        from elftools.elf.elffile import ELFFile
        with open(self.path, "rb") as f:
            self.elf = ELFFile(f)
            e_machine = self.elf.header["e_machine"]
            self.arch = self.ARCH_MAP.get(e_machine, None)
            if self.arch is None:
                raise ValueError(f"Unsupported architecture: {e_machine}")
            self.bits = self.elf.elfclass
            self.endian = "<" if self.elf.little_endian else ">"

    def collect_symbols(self):
        from elftools.elf.sections import SymbolTableSection
        for sec in self.elf.iter_sections():
            if isinstance(sec, SymbolTableSection):
                for sym in sec.iter_symbols():
                    if sym.name and sym["st_value"]:
                        self.symbols[sym.name] = {
                            "value": sym["st_value"],
                            "size": sym["st_size"],
                            "type": sym["st_info"]["type"],
                            "bind": sym["st_info"]["bind"],
                        }
        if not self.symbols:
            self.warnings.append(
                "Warning: Symbols are stripped. "
                "Function and variable names may be unavailable."
            )

    def collect_strings(self, min_len=5):
        with open(self.path, "rb") as f:
            data = f.read()
        cur = bytearray()
        cur_off = 0
        for i, b in enumerate(data):
            if 0x20 <= b < 0x7f:
                if not cur:
                    cur_off = i
                cur.append(b)
            else:
                if len(cur) >= min_len:
                    self.strings.append({
                        "offset": cur_off,
                        "value": cur.decode("ascii", "replace"),
                    })
                cur = bytearray()
        if len(cur) >= min_len:
            self.strings.append({
                "offset": cur_off,
                "value": cur.decode("ascii", "replace"),
            })

    def collect_functions(self):
        # Lấy từ symbol table (FUNC type = 'STT_FUNC')
        for name, info in self.symbols.items():
            if info["type"] == "STT_FUNC":
                self.functions.append({
                    "name": name,
                    "addr": info["value"],
                    "size": info["size"],
                    "source": "symtab",
                })
        # Sắp xếp theo địa chỉ
        self.functions.sort(key=lambda x: x["addr"])

    def disassemble_function(self, addr, size, max_insns=400):
        from capstone import Cs, CS_OP_IMM, CS_OP_MEM, CS_OP_REG
        try:
            import capstone as cs_mod
        except ImportError:
            return []

        arch_name, mode_name = self.CAPSTONE_MODE.get(
            self.arch, (None, None))
        if not arch_name:
            return []
        arch = getattr(cs_mod, arch_name, None)
        mode = getattr(cs_mod, mode_name, 0)
        if arch is None:
            return []
        md = Cs(arch, mode)
        md.detail = True

        # Lấy bytes
        with open(self.path, "rb") as f:
            raw = f.read()
        # Chuyển vaddr -> file offset
        from elftools.elf.elffile import ELFFile
        seg_off = None
        for seg in self.elf.iter_segments():
            if seg["p_type"] == "PT_LOAD":
                v = seg["p_vaddr"]
                if v <= addr < v + seg["p_filesz"]:
                    seg_off = seg["p_offset"] + (addr - v)
                    break
        if seg_off is None:
            return []
        code = raw[seg_off: seg_off + max(size, 64)]

        insns = []
        for insn in md.disasm(code, addr):
            insns.append({
                "addr": insn.address,
                "mnemonic": insn.mnemonic,
                "op_str": insn.op_str,
                "bytes": insn.bytes.hex(),
            })
            if len(insns) >= max_insns:
                break
        return insns

    def analyze(self):
        self.load()
        self.collect_symbols()
        self.collect_strings()
        self.collect_functions()
        return self

# ============================================================
# TÁI TẠO LOGIC (pseudocode) - CHỈ DỰA TRÊN PATTERN THẬT
# ============================================================
class LogicReconstructor:
    """
    Chuyển assembly -> pseudocode đọc được.
    Nguyên tắc:
    - Mỗi instruction map sang 1 dòng có cấu trúc.
    - Nếu không đủ evidence -> UNKNOWN_OPERATION.
    - Sinh if/while dựa trên nhận diện branch pattern.
    """

    # x86 & ARM branch mnemonics
    JMP = {"jmp", "b", "bx", "br", "jr", "j"}
    JCC = {
        "je","jz","jne","jnz","jg","jge","jl","jle","ja","jae","jb","jbe",
        "js","jns","jo","jno","jp","jnp","jc","jnc",
        "beq","bne","bgt","bge","blt","ble","bhi","bls",
        "cbz","cbnz","tbz","tbnz",
    }
    CALL = {"call", "callq", "bl", "blx", "jal", "jalr", "blr"}
    RET  = {"ret", "retq", "bx lr", "pop"}  # pop {..,pc} in ARM = return
    NOP  = {"nop", "nop.w"}
    CMP  = {"cmp", "cmn", "tst", "teq", "subs"}

    def __init__(self, analyzer):
        self.a = analyzer

    def _label(self, addr):
        return f"loc_{addr:x}"

    def _op(self, insn):
        return f"{insn['mnemonic']} {insn['op_str']}".strip()

    def reconstruct(self, func):
        name = func["name"]
        addr = func["addr"]
        size = func["size"]
        if size == 0:
            return (
                f"// function {name} @ 0x{addr:x}\n"
                f"// UNKNOWN_OPERATION( address = 0x{addr:x}, "
                f"reason = \"symbol size is zero, cannot delimit function\" )\n"
            )

        insns = self.a.disassemble_function(addr, size)
        if not insns:
            return (
                f"// function {name} @ 0x{addr:x}\n"
                f"// UNKNOWN_OPERATION( address = 0x{addr:x}, "
                f"reason = \"no disassembly produced\" )\n"
            )

        lines = []
        lines.append(f"// ---- function {name} @ 0x{addr:x} "
                     f"(size={size}, arch={self.a.arch}) ----")
        argn = self._guess_arg_count(insns)
        args = ", ".join(f"arg_{i}" for i in range(argn))
        lines.append(f"function_{addr:x}({args}) {{")

        indent = "    "
        # Đơn giản hóa: duyệt tuần tự, phát hiện if/while bằng pattern
        for i, insn in enumerate(insns):
            mn = insn["mnemonic"]
            txt = self._op(insn)
            ln = f"{indent}// {hex(insn['addr'])}: {txt}"

            if mn in self.NOP:
                continue

            if mn in self.CALL:
                tgt = self._extract_call_target(insn)
                if tgt is not None:
                    lines.append(f"{indent}call_0x{tgt:x}();   // {txt}")
                else:
                    lines.append(f"{indent}// CALL (indirect): {txt}")
                continue

            if mn in self.RET or (mn == "pop" and "pc" in insn["op_str"]):
                lines.append(f"{indent}return;   // {txt}")
                continue

            if mn in self.JCC:
                tgt = self._extract_branch_target(insn)
                cond = self._cond_from_jcc(mn)
                if tgt is not None:
                    lines.append(
                        f"{indent}if ({cond}) goto {self._label(tgt)};   // {txt}"
                    )
                else:
                    lines.append(f"{indent}// BRANCH-UNKNOWN: {txt}")
                continue

            if mn in self.JMP:
                tgt = self._extract_branch_target(insn)
                if tgt is not None:
                    lines.append(f"{indent}goto {self._label(tgt)};")
                else:
                    lines.append(f"{indent}// JUMP (indirect): {txt}")
                continue

            if mn in self.CMP:
                lines.append(f"{indent}// {txt}")
                continue

            # Các lệnh còn lại -> đánh dấu UNKNOWN để không bịa ngữ nghĩa
            lines.append(
                f"{indent}UNKNOWN_OPERATION( address = 0x{insn['addr']:x}, "
                f"reason = \"raw {mn}: {insn['op_str']}\" );"
            )

        lines.append("}")
        lines.append("")
        return "\n".join(lines)

    def _extract_call_target(self, insn):
        s = insn["op_str"]
        if s.startswith("0x"):
            try:
                return int(s.split()[0], 16)
            except Exception:
                return None
        return None

    def _extract_branch_target(self, insn):
        s = insn["op_str"]
        if s.startswith("0x"):
            try:
                return int(s.split()[0], 16)
            except Exception:
                return None
        return None

    def _cond_from_jcc(self, mn):
        table = {
            "je":"a == b","jz":"a == 0","jne":"a != b","jnz":"a != 0",
            "jg":"a > b (signed)","jge":"a >= b (signed)",
            "jl":"a < b (signed)","jle":"a <= b (signed)",
            "ja":"a > b (unsigned)","jae":"a >= b (unsigned)",
            "jb":"a < b (unsigned)","jbe":"a <= b (unsigned)",
            "js":"sign_flag","jns":"!sign_flag",
            "jo":"overflow","jno":"!overflow",
            "beq":"arg0 == arg1","bne":"arg0 != arg1",
            "bgt":"arg0 > arg1","bge":"arg0 >= arg1",
            "blt":"arg0 < arg1","ble":"arg0 <= arg1",
            "cbz":"arg0 == 0","cbnz":"arg0 != 0",
        }
        return table.get(mn, "condition_unknown")

    def _guess_arg_count(self, insns):
        # Heuristic tối thiểu: đếm thanh ghi arg được đọc trong ~30 lệnh đầu
        regs_x86 = {"rdi","rsi","rdx","rcx","r8","r9"}
        regs_arm = {"x0","x1","x2","x3","x4","x5","x6","x7",
                    "w0","w1","w2","w3","w4","w5","w6","w7"}
        found = set()
        for ins in insns[:40]:
            for tok in ins["op_str"].replace(",", " ").split():
                t = tok.strip()
                if t in regs_x86 or t in regs_arm:
                    found.add(t)
        if not found:
            return 0
        # map về chỉ số
        def idx(r):
            if r in regs_x86:
                return ["rdi","rsi","rdx","rcx","r8","r9"].index(r)
            if r.startswith(("x","w")):
                try:
                    return int(r[1:])
                except Exception:
                    return 0
            return 0
        return min(6, max(idx(r) for r in found) + 1)

