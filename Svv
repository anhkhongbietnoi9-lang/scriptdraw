def is_termux():
    prefix = os.environ.get("PREFIX", "")
    return (
        "com.termux" in prefix
        or os.path.exists("/data/data/com.termux/files/usr")
    )


def check_python():
    version = sys.version_info

    log(
        f"Python {version.major}.{version.minor}.{version.micro}"
    )

    if version < (3, 8):
        log_error("Python >= 3.8 is required.")
        sys.exit(1)


def has_command(command):
    return shutil.which(command) is not None


def install_python_package(package):
    log(f"Installing Python package: {package}")

    commands = [
        [
            sys.executable,
            "-m",
            "pip",
            "install",
            "--quiet",
            package,
        ],
        [
            sys.executable,
            "-m",
            "pip",
            "install",
            "--quiet",
            "--user",
            package,
        ],
    ]

    for command in commands:
        try:
            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=900,
            )

            if result.returncode == 0:
                return True

        except Exception:
            pass

    return False


def install_termux_package(package):
    if not is_termux():
        return False

    log(f"Installing Termux package: {package}")

    try:
        result = subprocess.run(
            ["pkg", "install", "-y", package],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=900,
        )

        return result.returncode == 0

    except Exception:
        return False


def check_dependencies():
    log("Checking Python dependencies...")

    missing = []

    for import_name, package_name in PY_DEPS.items():
        try:
            __import__(import_name)
            log(f"  OK: {package_name}")

        except ImportError:
            log(f"  MISSING: {package_name}")
            missing.append(package_name)

    for package in missing:
        if not install_python_package(package):
            log_error(
                f"Cannot install {package} automatically."
            )
            log_error(
                f"Run manually: pip install {package}"
            )
            sys.exit(1)

    log("Checking native tools...")

    missing_native = [
        command
        for command in NATIVE_DEPS
        if not has_command(command)
    ]

    if missing_native and is_termux():
        log("Installing missing Termux tools...")

        install_termux_package("binutils")
        install_termux_package("file")

        missing_native = [
            command
            for command in NATIVE_DEPS
            if not has_command(command)
        ]

    if missing_native:
        for command in missing_native:
            log_error(
                f"Missing native command: {command}"
            )

        log_error(
            "Install with: pkg install binutils file"
        )
        sys.exit(1)


