def is_termux():
    return "com.termux" in os.environ.get("PREFIX", "") or \
           os.path.exists("/data/data/com.termux/files/usr")

def check_python():
    log(f"Checking Python... {sys.version.split()[0]}")
    if sys.version_info < (3, 7):
        log_err("Python >= 3.7 required.")
        sys.exit(1)

def has_cmd(cmd):
    return shutil.which(cmd) is not None

def pip_install(pkg):
    log(f"Installing pip package: {pkg}")
    for extra in ([], ["--user"]):
        try:
            r = subprocess.run(
                [sys.executable, "-m", "pip", "install", "--quiet", *extra, pkg],
                capture_output=True, text=True, timeout=600
            )
            if r.returncode == 0:
                return True
        except Exception:
            pass
    return False

def apt_install(pkg):
    log(f"Installing apt package: {pkg}")
    try:
        r = subprocess.run(["pkg", "install", "-y", pkg],
                           capture_output=True, text=True, timeout=900)
        return r.returncode == 0
    except Exception:
        return False

def check_dependencies(auto_install=True):
    log("Checking Python dependencies...")
    missing_py = []
    for pkg in PY_DEPS:
        try:
            __import__(pkg)
            log(f"  OK: {pkg}")
        except ImportError:
            missing_py.append(pkg)
            log(f"  MISSING: {pkg}")

    if missing_py and auto_install:
        for pkg in missing_py:
            if not pip_install(pkg):
                log_err(f"Missing dependency: {pkg}")
                log_err(f"Please install manually: pip install {pkg}")
                sys.exit(1)

    log("Checking native reverse-engineering tools...")
    missing_native = [c for c in NATIVE_DEPS if not has_cmd(c)]
    if missing_native and auto_install and is_termux():
        # binutils cung cấp objdump + readelf
        apt_install("binutils")
        apt_install("file")
        missing_native = [c for c in NATIVE_DEPS if not has_cmd(c)]

    if missing_native:
        for m in missing_native:
            log_err(f"Missing dependency: {m}")
        log_err("Please install it before continuing (e.g. pkg install binutils file).")
        sys.exit(1)

def check_storage():
    log("Checking Termux environment...")
    if not is_termux():
        log("  Not running on Termux (PC/dev mode). Skipping storage check.")
        return
    dl = "/sdcard/Download"
    if not os.path.exists("/sdcard"):
        log_err("Storage permission not granted.")
        log_err("Please run: termux-setup-storage")
    elif not os.path.exists(dl):
        log(f"  Warning: {dl} not found (still OK).")
    else:
        log(f"  Download dir OK: {dl}")

def check_port(port):
    log(f"Checking port {port}...")
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind((HOST, port))
        s.close()
        return True
    except OSError:
        log_err(f"Port {port} is in use.")
        return False

