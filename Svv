# PIPELINE PHÂN TÍCH CHÍNH
# ============================================================
def analyze_so(so_path, job_id):
    log(f"Analyzing {so_path}...")
    start = time.time()
    report_lines = []
    report_lines.append("=" * 60)
    report_lines.append("SO LOGIC RECONSTRUCTOR - OUTPUT")
    report_lines.append("=" * 60)
    report_lines.append(f"File: {os.path.basename(so_path)}")
    report_lines.append(f"Job:  {job_id}")
    report_lines.append(f"SHA1: {hashlib.sha1(open(so_path,'rb').read()).hexdigest()}")
    report_lines.append("")

    # 1. Kiểm tra ELF
    try:
        with open(so_path, "rb") as f:
            magic = f.read(4)
    except Exception as e:
        return {"ok": False, "error": f"Cannot read file: {e}"}

    if magic != b"\x7fELF":
        return {"ok": False, "error": "Invalid ELF file."}

    # 2. Load ELF
    try:
        analyzer = ELFAnalyzer(so_path).analyze()
    except ValueError as e:
        return {"ok": False, "error": str(e)}
    except Exception as e:
        return {"ok": False, "error": f"ELF parse error: {e}"}

    report_lines.append("--- ELF HEADER ---")
    report_lines.append(f"Architecture : {analyzer.arch}")
    report_lines.append(f"Bits         : {analyzer.bits}")
    report_lines.append(f"Endian       : {'little' if analyzer.endian=='<' else 'big'}")
    report_lines.append("")

    if analyzer.warnings:
        report_lines.append("--- WARNINGS ---")
        for w in analyzer.warnings:
            report_lines.append(w)
        report_lines.append("")

    # 3. Sections
    report_lines.append("--- SECTIONS ---")
    for sec in analyzer.elf.iter_sections():
        try:
            report_lines.append(
                f"  {sec.name:<20} type={sec['sh_type']:<16} "
                f"addr=0x{sec['sh_addr']:x} size=0x{sec['sh_size']:x}"
            )
        except Exception:
            pass
    report_lines.append("")

    # 4. Strings (giới hạn 200)
    report_lines.append(f"--- STRINGS (showing up to 200 of {len(analyzer.strings)}) ---")
    for s in analyzer.strings[:200]:
        report_lines.append(f"  0x{s['offset']:08x}: {s['value']}")
    report_lines.append("")

    # 5. Functions
    report_lines.append(f"--- FUNCTIONS ({len(analyzer.functions)}) ---")
    for fn in analyzer.functions:
        report_lines.append(
            f"  {fn['name']:<40} @ 0x{fn['addr']:x}  size=0x{fn['size']:x}"
        )
    report_lines.append("")

    if not analyzer.functions:
        report_lines.append(
            "Partial reconstruction: No FUNC symbols found in binary. "
            "Cannot enumerate function boundaries reliably. "
            "Only sections/strings above are trustworthy."
        )

    # 6. Reconstruct từng function
    report_lines.append("=" * 60)
    report_lines.append("--- RECONSTRUCTED LOGIC ---")
    report_lines.append("=" * 60)
    recon = LogicReconstructor(analyzer)
    for fn in analyzer.functions:
        try:
            report_lines.append(recon.reconstruct(fn))
        except Exception as e:
            report_lines.append(
                f"// function {fn['name']} @ 0x{fn['addr']:x}"
            )
            report_lines.append(
                f"// UNKNOWN_OPERATION( address = 0x{fn['addr']:x}, "
                f"reason = \"reconstruction failed: {e}\" )"
            )
            report_lines.append("")

    elapsed = time.time() - start
    report_lines.append("=" * 60)
    report_lines.append(f"Done in {elapsed:.2f}s")
    report_lines.append("=" * 60)

    text = "\n".join(report_lines)

    # Lưu output
    out_path = os.path.join(OUTPUT_DIR, f"{job_id}.txt")
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(text)

    # Log file
    log_path = os.path.join(LOG_DIR, f"{job_id}.log")
    with open(log_path, "w", encoding="utf-8") as f:
        f.write(text)

    return {
        "ok": True,
        "job_id": job_id,
        "arch": analyzer.arch,
        "bits": analyzer.bits,
        "num_functions": len(analyzer.functions),
        "num_strings": len(analyzer.strings),
        "warnings": analyzer.warnings,
        "text": text,
        "download": f"/download/{job_id}",
    }

