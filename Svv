# ============================================================

class ELFAnalyzer:

    ARCH_MAP = {
        "EM_386": "x86",
        "EM_X86_64": "x86_64",
        "EM_ARM": "ARM",
        "EM_AARCH64": "ARM64",
        "EM_MIPS": "MIPS",
        "EM_MIPS_RS3_LE": "MIPS",
        "EM_RISCV": "RISC-V",
    }

    def __init__(self, path):
        self.path = path

        self.elf = None
        self.arch = None
        self.bits = None
        self.endian = "<"

        self.symbols = {}
        self.functions = []
        self.strings = []

        self.sections = []
        self.warnings = []

        self.raw = b""

    # --------------------------------------------------------
    # LOAD
    # --------------------------------------------------------

    def load(self):
        from elftools.elf.elffile import ELFFile

        with open(self.path, "rb") as file:
            self.raw = file.read()

        if self.raw[:4] != b"\x7fELF":
            raise ValueError("Invalid ELF file.")

        with open(self.path, "rb") as file:
            self.elf = ELFFile(file)

            machine = self.elf.header["e_machine"]

            self.arch = self.ARCH_MAP.get(machine)

            if self.arch is None:
                raise ValueError(
                    f"Unsupported architecture: {machine}"
                )

            self.bits = self.elf.elfclass

            self.endian = (
                "<"
                if self.elf.little_endian
                else ">"
            )

    # --------------------------------------------------------
    # SECTIONS
    # --------------------------------------------------------

    def collect_sections(self):
        self.sections.clear()

        for section in self.elf.iter_sections():

            try:
                item = {
                    "name": section.name,
                    "type": section["sh_type"],
                    "address": section["sh_addr"],
                    "offset": section["sh_offset"],
                    "size": section["sh_size"],
                    "flags": section["sh_flags"],
                }

                self.sections.append(item)

            except Exception:
                continue

    # --------------------------------------------------------
    # SYMBOLS
    # --------------------------------------------------------

    def collect_symbols(self):
        from elftools.elf.sections import SymbolTableSection

        self.symbols.clear()

        for section in self.elf.iter_sections():

            if not isinstance(
                section,
                SymbolTableSection,
            ):
                continue

            try:
                symbols = section.iter_symbols()

                for symbol in symbols:

                    name = symbol.name

                    if not name:
                        continue

                    value = int(symbol["st_value"])
                    size = int(symbol["st_size"])

                    symbol_type = symbol["st_info"]["type"]
                    bind = symbol["st_info"]["bind"]

                    self.symbols[name] = {
                        "name": name,
                        "value": value,
                        "size": size,
                        "type": symbol_type,
                        "bind": bind,
                    }

            except Exception as error:
                self.warnings.append(
                    f"Symbol table read error: {error}"
                )

        if not self.symbols:
            self.warnings.append(
                "No symbols found. "
                "The binary may be stripped."
            )

    # --------------------------------------------------------
    # FUNCTIONS
    # --------------------------------------------------------

    def collect_functions(self):
        self.functions.clear()

        seen = set()

        for name, info in self.symbols.items():

            if info["type"] != "STT_FUNC":
                continue

            address = info["value"]

            if address in seen:
                continue

            seen.add(address)

            self.functions.append({
                "name": name,
                "addr": address,
                "size": info["size"],
                "source": "symbol",
            })

        self.functions.sort(
            key=lambda item: item["addr"]
        )

        # ----------------------------------------------------
        # Infer zero-size function boundaries from next symbol
        # ----------------------------------------------------

        for index, function in enumerate(self.functions):

            if function["size"] != 0:
                continue

            if index + 1 < len(self.functions):

                next_function = self.functions[index + 1]

                difference = (
                    next_function["addr"]
                    - function["addr"]
                )

                if difference > 0:
                    function["size"] = difference
                    function["source"] = (
                        "symbol+next-symbol-boundary"
                    )

    # --------------------------------------------------------
    # STRINGS
    # --------------------------------------------------------

    def collect_strings(self, minimum=5):
        self.strings.clear()

        data = self.raw

        start = None

        for index, byte in enumerate(data):

            printable = (
                0x20 <= byte <= 0x7E
            )

            if printable:

                if start is None:
                    start = index

            else:

                if start is not None:

                    length = index - start

                    if length >= minimum:

                        value = data[
                            start:index
                        ].decode(
                            "ascii",
                            "replace",
                        )

                        self.strings.append({
                            "offset": start,
                            "value": value,
                        })

                    start = None

        if start is not None:

            length = len(data) - start

            if length >= minimum:

                value = data[
                    start:
                ].decode(
                    "ascii",
                    "replace",
                )

                self.strings.append({
                    "offset": start,
                    "value": value,
                })

    # --------------------------------------------------------
    # ADDRESS -> FILE OFFSET
    # --------------------------------------------------------

    def virtual_address_to_file_offset(self, address):

        for segment in self.elf.iter_segments():

            try:

                if segment["p_type"] != "PT_LOAD":
                    continue

                virtual_start = segment["p_vaddr"]
                file_size = segment["p_filesz"]

                virtual_end = (
                    virtual_start + file_size
                )

                if (
                    virtual_start
                    <= address
                    < virtual_end
                ):

                    delta = (
                        address
                        - virtual_start
                    )

                    return (
                        segment["p_offset"]
                        + delta
                    )

            except Exception:
                continue

        return None

    # --------------------------------------------------------
    # DISASSEMBLE
    # --------------------------------------------------------

    def disassemble_function(
        self,
        address,
        size,
        max_instructions=1000,
    ):
        import capstone

        architecture = self.arch

        if architecture == "x86":

            cs_arch = capstone.CS_ARCH_X86
            cs_mode = capstone.CS_MODE_32

        elif architecture == "x86_64":

            cs_arch = capstone.CS_ARCH_X86
            cs_mode = capstone.CS_MODE_64

        elif architecture == "ARM":

            cs_arch = capstone.CS_ARCH_ARM
            cs_mode = (
                capstone.CS_MODE_ARM
                | (
                    capstone.CS_MODE_BIG_ENDIAN
                    if self.endian == ">"
                    else 0
                )
            )

        elif architecture == "ARM64":

            cs_arch = capstone.CS_ARCH_ARM64

            cs_mode = (
                capstone.CS_MODE_BIG_ENDIAN
                if self.endian == ">"
                else capstone.CS_MODE_LITTLE_ENDIAN
            )

        elif architecture == "MIPS":

            cs_arch = capstone.CS_ARCH_MIPS

            cs_mode = capstone.CS_MODE_MIPS32

            if self.bits == 64:
                cs_mode = capstone.CS_MODE_MIPS64

            if self.endian == ">":
                cs_mode |= capstone.CS_MODE_BIG_ENDIAN
            else:
                cs_mode |= capstone.CS_MODE_LITTLE_ENDIAN

        elif architecture == "RISC-V":

            cs_arch = capstone.CS_ARCH_RISCV

            if self.bits == 64:
                cs_mode = capstone.CS_MODE_RISCV64
            else:
                cs_mode = capstone.CS_MODE_RISCV32

        else:
            return []

        file_offset = (
            self.virtual_address_to_file_offset(
                address
            )
        )

        if file_offset is None:
            return []

        if size <= 0:
            size = 4096

        maximum_bytes = min(
            size,
            1024 * 1024,
        )

        code = self.raw[
            file_offset:
            file_offset + maximum_bytes
        ]

        if not code:
            return []

        try:

            disassembler = capstone.Cs(
                cs_arch,
                cs_mode,
            )

            disassembler.detail = True

            instructions = []

            for instruction in disassembler.disasm(
                code,
                address,
            ):

                instructions.append({
                    "address": instruction.address,
                    "mnemonic": instruction.mnemonic,
                    "op_str": instruction.op_str,
                    "bytes": instruction.bytes.hex(),
                })

                if (
                    len(instructions)
                    >= max_instructions
                ):
                    break

            return instructions

        except Exception as error:

            self.warnings.append(
                f"Disassembly error at "
                f"0x{address:x}: {error}"
            )

            return []

    # --------------------------------------------------------
    # ANALYZE
    # --------------------------------------------------------

    def analyze(self):

        self.load()
        self.collect_sections()
        self.collect_symbols()
        self.collect_functions()
        self.collect_strings()

        return self


