# ============================================================

def main():

    global PORT

    print()
    print("=" * 70)
    print(" SO LOGIC RECONSTRUCTOR")
    print(" by MC_meme_edit")
    print("=" * 70)
    print()

    check_python()

    prepare_workspace()

    check_dependencies()

    check_storage()


    # --------------------------------------------------------
    # Find port
    # --------------------------------------------------------

    if not port_available(PORT):

        log(
            f"Port {PORT} is busy."
        )

        new_port = find_free_port(
            PORT + 1
        )

        if new_port is None:

            log_error(
                "No free port found."
            )

            sys.exit(1)

        PORT = new_port

        log(
            f"Using port {PORT}."
        )


    # --------------------------------------------------------
    # Server
    # --------------------------------------------------------

    address = (
        f"http://{HOST}:{PORT}"
    )

    log(
        f"Starting server: "
        f"{address}"
    )


    try:

        server = (
            ThreadingHTTPServer(
                (HOST, PORT),
                Handler
            )
        )

    except Exception as error:

        log_error(
            f"Server startup failed: "
            f"{error}"
        )

        sys.exit(1)


    log(
        f"Server ready: {address}"
    )

    open_browser(
        address
    )


    # --------------------------------------------------------
    # Shutdown
    # --------------------------------------------------------

    def shutdown(
        signum=None,
        frame=None
    ):

        print()

        log(
            "Shutting down server..."
        )

        try:

            server.shutdown()

        except Exception:
            pass


    try:

        signal.signal(
            signal.SIGINT,
            shutdown
        )

        signal.signal(
            signal.SIGTERM,
            shutdown
        )

    except Exception:
        pass


    try:

        server.serve_forever()

    except KeyboardInterrupt:

        shutdown()

    finally:

        try:
            server.server_close()
        except Exception:
            pass

        log(
            "Server stopped."
        )


