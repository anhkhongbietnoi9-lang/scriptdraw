*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --purple-1: #b05cff;
    --purple-2: #8a3cff;
    --purple-3: #511997;
    --dark-bg: #0c0914;
    --input-bg: linear-gradient(180deg, #111117, #0c0c11);
    --morph-bg-gradient: linear-gradient(145deg, var(--purple-1) 0%, var(--purple-2) 48%, var(--purple-3) 100%);
}

body {
    width: 100%;
    min-height: 100dvh;
    background: radial-gradient(circle at center, #241238 0%, #10091a 60%, #06050a 100%);
    display: grid;
    place-items: center;
    overflow: hidden;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #ffffff;
    -webkit-font-smoothing: antialiased;
}

.morph {
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(81, 25, 151, 0.4);
    width: 210px;
    height: 62px;
    border-radius: 20px;
    background: var(--morph-bg-gradient);
    cursor: pointer;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                border-radius 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.4s ease,
                box-shadow 0.6s ease;
    animation: loadIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: width, height, border-radius, transform;
}

@keyframes loadIn {
    from { transform: translateY(120px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}

.morph.open {
    cursor: default;
    width: min(900px, 94vw);
    height: min(560px, 90dvh);
    border-radius: 28px;
    background: var(--dark-bg);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(176, 92, 255, 0.1);
}

@media (max-width: 780px) {
    .morph.open { width: 92vw; height: 82vh; }
}

@media (max-width: 600px) {
    .morph.open { width: 94vw; height: 90dvh; }
}

@media (max-height: 700px) {
    .morph.open { height: 94dvh; }
}

.btn-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    opacity: 1;
    transition: opacity 0.3s 0.3s ease;
    pointer-events: none;
}

.morph.open .btn-text,
.morph.shrinking .btn-text {
    opacity: 0;
    transition: opacity 0.1s;
}

.ui-container {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
}

.morph.open .ui-container {
    opacity: 1;
    pointer-events: auto;
}

.purple-block {
    position: absolute;
    top: 0; left: 0;
    width: 57%;
    height: 100%;
    background: var(--morph-bg-gradient);
    clip-path: polygon(0 0, 72% 0, 100% 100%, 0 100%);
    z-index: 2;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}

@media (max-width: 600px) {
    .purple-block {
        width: 100%;
        height: 34%;
        clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
    }
}

.glow-circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    background: rgba(255, 255, 255, 0.12);
}

.c1 { width: 180px; height: 180px; top: -30px; left: -30px; }
.c2 { width: 300px; height: 300px; bottom: -60px; right: -60px; }

.welcome-text {
    position: absolute;
    top: 42%;
    left: 12%;
    width: 60%;
    opacity: 0;
    transform: translateX(-35px);
    transition: opacity 0.5s 0.3s ease, transform 0.5s 0.3s ease;
    z-index: 3;
}

.morph.open .welcome-text {
    opacity: 1;
    transform: translateX(0);
}

.welcome-text h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 12px;
}

.welcome-text p {
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
}

@media (max-width: 600px) {
    .welcome-text {
        top: 20%;
        left: 8%;
        width: 85%;
    }

    .welcome-text h1 {
        font-size: 1.8rem;
        margin-bottom: 6px;
    }

    .welcome-text p {
        font-size: 0.9rem;
    }
}

.diagonal-line {
    position: absolute;
    left: 56.8%;
    top: -10%;
    width: 2px;
    height: 120%;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.9), 0 0 24px var(--purple-1);
    transform: rotate(14deg) scaleY(0);
    transform-origin: top;
    z-index: 3;
    opacity: 0;
    transition: transform 0.6s 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s;
}

.morph.open .diagonal-line {
    transform: rotate(14deg) scaleY(1);
    opacity: 1;
}

@media (max-width: 600px) {
    .diagonal-line {
        left: -10%;
        top: 33.8%;
        width: 120%;
        height: 2px;
        transform: rotate(-6deg) scaleX(0);
        transform-origin: left;
    }

    .morph.open .diagonal-line {
        transform: rotate(-6deg) scaleX(1);
    }
}

.form-area {
    position: absolute;
    top: 0; right: 0;
    width: 43%;
    height: 100%;
    z-index: 1;
    opacity: 0;
    transform: translateX(30px);
    transition: opacity 0.5s 0.4s ease, transform 0.5s 0.4s ease;
}

.morph.open .form-area {
    opacity: 1;
    transform: translate(0);
}

@media (max-width: 600px) {
    .form-area {
        top: auto;
        bottom: 0;
        width: 100%;
        height: 66%;
        transform: translateY(30px);
    }
}

.pages-slider {
    display: flex;
    width: 200%;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}

.pages-slider.show-create {
    transform: translateX(-50%);
}

.page {
    width: 50%;
    height: 100%;
    padding: max(35px, env(safe-area-inset-top)) max(35px, env(safe-area-inset-right)) max(35px, env(safe-area-inset-bottom)) max(35px, env(safe-area-inset-left));
    overflow-y: auto;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

@media (max-width: 600px) {
    .page {
        padding: 25px 20px;
        justify-content: flex-start;
    }
}

.form-title {
    font-size: 1.8rem;
    margin-bottom: 8px;
    font-weight: 600;
}

.form-desc {
    font-size: 0.95rem;
    color: #a0a0a5;
    margin-bottom: 30px;
}

.input-group {
    margin-bottom: 18px;
    width: 100%;
    max-width: 315px;
}

.input-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.85rem;
    color: #bbb;
    letter-spacing: 0.3px;
}

.input-group input {
    width: 100%;
    height: 48px;
    border-radius: 12px;
    background: var(--input-bg);
    border: 1px solid rgba(255,255,255,0.06);
    color: #fff;
    padding: 0 16px;
    font-size: 1rem;
    transition: all 0.3s;
    font-family: inherit;
}

.input-group input::placeholder {
    color: #555;
}

.input-group input:focus {
    outline: none;
    border-color: rgba(160, 89, 255, 0.85);
    box-shadow: 0 0 0 3px rgba(137, 52, 255, 0.08), 0 0 18px rgba(137, 52, 255, 0.15);
    background: #120e1a;
}

.submit-btn {
    width: 100%;
    max-width: 315px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ad59ff, #7d31e8);
    border: none;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 10px;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(125, 49, 232, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
}

.submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(125, 49, 232, 0.6);
}

.submit-btn:active {
    transform: translateY(0);
}

.switch-link {
    text-align: left;
    margin-top: 25px;
    font-size: 0.9rem;
    color: #888;
}

.switch-link a {
    color: var(--purple-1);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
}

.switch-link a:hover {
    color: #c88cff;
    text-decoration: underline;
}

.close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.3s 0.6s ease;
}

.morph.open .close-btn {
    opacity: 1;
    transform: scale(1);
}

.close-btn:hover {
    background: rgba(255,255,255,0.15);
    transform: scale(1.15) rotate(90deg);
    transition: all 0.3s ease;
}

.msg-box {
    padding: 12px;
    border-radius: 10px;
    font-size: 0.85rem;
    margin-bottom: 20px;
    display: none;
    width: 100%;
    max-width: 315px;
}

.msg-box.error {
    background: rgba(255, 60, 60, 0.15);
    border: 1px solid rgba(255, 60, 60, 0.3);
    color: #ff9999;
}

.msg-box.success {
    background: rgba(60, 255, 60, 0.15);
    border: 1px solid rgba(60, 255, 60, 0.3);
    color: #99ff99;
}

::-webkit-scrollbar {
    width: 4px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.15);
    border-radius: 10px;
}

.morph.closing-1 .form-area,
.morph.closing-1 .welcome-text,
.morph.closing-1 .diagonal-line,
.morph.closing-1 .close-btn {
    opacity: 0 !important;
    transform: scale(0.95) !important;
    transition: all 0.3s ease !important;
    pointer-events: none;
}

.morph.closing-2 .purple-block {
    width: 100% !important;
    height: 100% !important;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%) !important;
    border-radius: inherit;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1) !important;
}

.morph.closing-2 {
    background: var(--morph-bg-gradient) !important;
}

@media (prefers-reduced-motion: reduce) {
    .morph, .purple-block, .diagonal-line, .form-area, .welcome-text, .pages-slider {
        transition-duration: 0.1s !important;
    }
}