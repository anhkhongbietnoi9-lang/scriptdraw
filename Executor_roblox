    def is_rate_limited(self, client_id: str) -> bool:
        """Check if client is rate limited"""
        now = time.time()
        if client_id not in self.rate_limits:
            self.rate_limits[client_id] = deque(maxlen=self.max_requests_per_minute)
        
        # Remove old timestamps
        while self.rate_limits[client_id] and self.rate_limits[client_id][0] < now - 60:
            self.rate_limits[client_id].popleft()
        
        if len(self.rate_limits[client_id]) >= self.max_requests_per_minute:
            return True
        
        self.rate_limits[client_id].append(now)
        return False
    
    async def handle_client(self, websocket):
        client_ip = websocket.remote_address[0] if websocket.remote_address else "unknown"
        client_id = f"RBX-{secrets.token_hex(4).upper()}"
        
        self.clients[client_id] = {
            'ws': websocket,
            'connected_at': datetime.now(),
            'ip': client_ip,
            'last_event': 'HANDSHAKE',
            'ping': 0,
            'fps': 0,
            'rtt': 0,
            'client_uptime': 'N/A',
            'memory': 'N/A',
            'authenticated': False,
            'auth_token': self.generate_auth_token(),
            'packets_received': 0,
            'packets_sent': 0,
            'ping_history': deque(maxlen=30),
            'fps_history': deque(maxlen=30)
        }
        
        self.auth_tokens[client_id] = self.clients[client_id]['auth_token']
        self.valid_tokens.add(self.clients[client_id]['auth_token'])
        
        self.log_activity(f"{self.C['green']}[WS]{self.C['reset']}     Connection from {client_id} ({client_ip})")
        
        try:
            # Send handshake với auth token
            await self.send_handshake(websocket, client_id)
            
            async for message in websocket:
                try:
                    data = json.loads(message)
                    self.clients[client_id]['packets_received'] += 1
                    
                    # Rate limiting
                    if self.is_rate_limited(client_id):
                        await websocket.send(json.dumps({
                            'type': 'error',
                            'code': 'RATE_LIMITED',
                            'message': 'Too many requests'
                        }))
                        continue
                    
                    await self.process_command(client_id, data)
                except json.JSONDecodeError:
                    self.log_activity(f"{self.C['red']}[ERR]{self.C['reset']}    Invalid JSON from {client_id}")
                    await websocket.send(json.dumps({
                        'type': 'error',
                        'code': 'INVALID_JSON',
                        'message': 'Invalid JSON format'
                    }))
                    
        except websockets.exceptions.ConnectionClosed:
            self.log_activity(f"{self.C['red']}[DISC]{self.C['reset']}   Client {client_id} disconnected")
        finally:
            if client_id in self.clients:
                # Clean up auth tokens
                if client_id in self.auth_tokens:
                    self.valid_tokens.discard(self.auth_tokens[client_id])
                    del self.auth_tokens[client_id]
                if client_id in self.rate_limits:
                    del self.rate_limits[client_id]
                del self.clients[client_id]
    
    async def send_handshake(self, websocket, client_id: str):
        """Send handshake with auth token"""
        handshake = {
            'type': 'handshake',
            'session_id': self.session_id,
            'client_id': client_id,
            'auth_token': self.clients[client_id]['auth_token'],
            'timestamp': datetime.now().isoformat()
        }
        await websocket.send(json.dumps(handshake))
        self.clients[client_id]['packets_sent'] += 1
        self.log_activity(f"{self.C['blue']}[AUTH]{self.C['reset']}   Token sent to {client_id}")
    
    def verify_auth(self, client_id: str, token: str) -> bool:
        """Verify client authentication"""
        if client_id not in self.auth_tokens:
            return False
        return token == self.auth_tokens[client_id]
    
    async def process_command(self, client_id: str, data: Dict[str, Any]):
        """Process client commands with whitelist"""
        command = data.get('command', '').lower()
        token = data.get('auth_token', '')
        
        # Verify authentication
        if not self.verify_auth(client_id, token):
            await self.clients[client_id]['ws'].send(json.dumps({
                'type': 'error',
                'code': 'UNAUTHORIZED',
                'message': 'Invalid authentication token'
            }))
            return
        
        # Mark as authenticated
        self.clients[client_id]['authenticated'] = True
        
        # Check command whitelist
        if command not in self.allowed_commands:
            await self.clients[client_id]['ws'].send(json.dumps({
                'type': 'error',
                'code': 'INVALID_COMMAND',
                'message': f'Command {command} not allowed'
            }))
            return
        
        self.clients[client_id]['last_event'] = command.upper()
        
        if command == 'stats':
            await self.handle_stats(client_id, data)
        elif command == 'ping':
            await self.handle_ping(client_id)
        elif command == 'sync':
            await self.handle_sync(client_id)
        elif command == 'notify':
            await self.handle_notify(client_id, data)
        elif command == 'status':
            await self.handle_status(client_id)
    
    async def handle_stats(self, client_id: str, data: Dict[str, Any]):
        """Handle telemetry stats"""
        ping = data.get('ping', 0)
        fps = data.get('fps', 0)
        rtt = data.get('rtt', 0)
        client_uptime = data.get('uptime', 'N/A')
        memory = data.get('memory', 'N/A')
        
        self.clients[client_id]['ping'] = ping
        self.clients[client_id]['fps'] = fps
        self.clients[client_id]['rtt'] = rtt
        self.clients[client_id]['client_uptime'] = client_uptime
        self.clients[client_id]['memory'] = memory
        
        # Store history
        self.clients[client_id]['ping_history'].append(ping)
        self.clients[client_id]['fps_history'].append(fps)
        
        avg_ping = sum(self.clients[client_id]['ping_history']) / len(self.clients[client_id]['ping_history']) if self.clients[client_id]['ping_history'] else 0
        avg_fps = sum(self.clients[client_id]['fps_history']) / len(self.clients[client_id]['fps_history']) if self.clients[client_id]['fps_history'] else 0
        
        self.log_activity(
            f"{self.C['green']}[STATS]{self.C['reset']}  {client_id} - "
            f"Ping: {ping:.1f}ms | FPS: {fps:.0f} | RTT: {rtt:.1f}ms | "
            f"Avg Ping: {avg_ping:.1f}ms | Avg FPS: {avg_fps:.0f}"
        )
        
        await self.clients[client_id]['ws'].send(json.dumps({
            'type': 'stats_ack',
            'received': True,
            'timestamp': datetime.now().isoformat()
        }))
    
