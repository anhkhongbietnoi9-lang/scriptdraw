    async def handle_status(self, client_id: str):
        """Handle status request"""
        info = {
            'connected': True,
            'session': self.session_id,
            'client_id': client_id,
            'uptime': str(datetime.now() - self.start_time).split('.')[0],
            'clients': len(self.clients)
        }
        await self.clients[client_id]['ws'].send(json.dumps({
            'type': 'status_response',
            'data': info,
            'timestamp': datetime.now().isoformat()
        }))
    
    async def send_notification(self, message: str):
        """Send notification to all clients"""
        if not self.clients:
            self.log_activity(f"{self.C['yellow']}[WARN]{self.C['reset']}   No clients to notify")
            return 0
        
        payload = {
            'type': 'notification',
            'message': message,
            'timestamp': datetime.now().isoformat()
        }
        
        success = 0
        for client_id, client_data in self.clients.items():
            try:
                await client_data['ws'].send(json.dumps(payload))
                success += 1
            except Exception as e:
                self.log_activity(f"{self.C['red']}[ERR]{self.C['reset']}    Failed to notify {client_id}: {e}")
        
        self.log_activity(f"{self.C['green']}[NOTIFY]{self.C['reset']} Sent to {success} clients")
        return success
    
    def console_interface(self, loop: asyncio.AbstractEventLoop):
        """Console interface running in separate thread"""
        while self.running:
            try:
                self.print_terminal_prompt()
                cmd = input().strip()
                
                if not cmd:
                    continue
                
                self.command_history.append(cmd)
                
                if cmd == 'help':
                    self.print_help()
                    
                elif cmd == 'clear':
                    self.clear_screen()
                    self.print_banner()
                    self.print_status_panel()
                    self.print_client_info()
                    self.print_activity_log()
                    
                elif cmd == 'clients':
                    if not self.clients:
                        print(f"{self.C['yellow']}[!] No clients connected{self.C['reset']}")
                    else:
                        print(f"\n{self.C['cyan']}[+] Connected Clients:{self.C['reset']}")
                        for client_id, client_data in self.clients.items():
                            auth_status = f"{self.C['green']}✓{self.C['reset']}" if client_data.get('authenticated') else f"{self.C['red']}✗{self.C['reset']}"
                            ping = client_data.get('ping', 0)
                            fps = client_data.get('fps', 0)
                            print(f"  {self.C['green']}●{self.C['reset']} {client_id} [{auth_status}]")
                            print(f"    Ping: {ping:.1f}ms | FPS: {fps:.0f}")
                            print(f"    IP: {client_data['ip']}")
                            print()
                            
                elif cmd == 'status':
                    self.clear_screen()
                    self.print_banner()
                    self.print_status_panel()
                    self.print_client_info()
                    self.print_activity_log()
                    
                elif cmd == 'stats':
                    if not self.clients:
                        print(f"{self.C['red']}[!] No clients connected{self.C['reset']}")
                        continue
                    
                    print(f"\n{self.C['cyan']}[ TELEMETRY ]{self.C['reset']}")
                    for client_id, client_data in self.clients.items():
                        ping = client_data.get('ping', 0)
                        fps = client_data.get('fps', 0)
                        rtt = client_data.get('rtt', 0)
                        memory = client_data.get('memory', 'N/A')
                        uptime = client_data.get('client_uptime', 'N/A')
                        
                        print(f"\n  {self.C['yellow']}{client_id}{self.C['reset']}")
                        print(f"    WebSocket RTT: {rtt:.1f}ms")
                        print(f"    Game Ping:     {ping:.1f}ms")
                        print(f"    FPS:           {fps:.0f}")
                        print(f"    Memory:        {memory}")
                        print(f"    Uptime:        {uptime}")
                    
                elif cmd.startswith('notify '):
                    message = cmd[7:]
                    if message:
                        count = asyncio.run_coroutine_threadsafe(
                            self.send_notification(message),
                            loop
                        ).result()
                        print(f"{self.C['green']}[+] Notification sent to {count} clients{self.C['reset']}")
                    else:
                        print(f"{self.C['red']}[!] No message provided{self.C['reset']}")
                    
                elif cmd == 'logs':
                    print(f"\n{self.C['cyan']}[ ACTIVITY LOGS ]{self.C['reset']}")
                    for log in self.activity_logs:
                        print(f"  {log}")
                        
                elif cmd == 'session':
                    print(f"""
{self.C['cyan']}[ SESSION INFO ]{self.C['reset']}
  Session ID  : {self.C['yellow']}{self.session_id}{self.C['reset']}
  Start Time  : {self.C['green']}{self.start_time.strftime('%Y-%m-%d %H:%M:%S')}{self.C['reset']}
  Uptime      : {self.C['green']}{str(datetime.now() - self.start_time).split('.')[0]}{self.C['reset']}
  Clients     : {self.C['yellow']}{len(self.clients)}{self.C['reset']}
  Auth Tokens : {self.C['yellow']}{len(self.valid_tokens)}{self.C['reset']}
  Rate Limit  : {self.C['green']}{self.max_requests_per_minute}/min{self.C['reset']}""")
                    
                elif cmd == 'exit':
                    self.running = False
                    print(f"{self.C['red']}[!] Shutting down...{self.C['reset']}")
                    break
                    
                else:
                    print(f"{self.C['red']}[!] Unknown command: {cmd}{self.C['reset']}")
                    print(f"{self.C['yellow']}Type 'help' for available commands{self.C['reset']}")
                    
            except KeyboardInterrupt:
                self.running = False
                print(f"\n{self.C['red']}[!] Shutting down...{self.C['reset']}")
                break
            except Exception as e:
                print(f"{self.C['red']}[!] Error: {e}{self.C['reset']}")

    async def start_server(self, host='0.0.0.0', port=8765):
        self.loop = asyncio.get_running_loop()
        
        self.clear_screen()
        self.print_banner()
        self.print_status_panel()
        self.print_client_info()
        self.print_activity_log()
        
        print(f"\n{self.C['green']}[+] Secure Neural Console Server started!{self.C['reset']}")
        print(f"{self.C['cyan']}[+] Listening on {host}:{port}{self.C['reset']}")
        print(f"{self.C['yellow']}[+] Session: {self.session_id}{self.C['reset']}")
        print(f"{self.C['green']}[+] Command Whitelist: {', '.join(self.allowed_commands)}{self.C['reset']}")
        print(f"{self.C['green']}[+] Rate Limit: {self.max_requests_per_minute} req/min{self.C['reset']}")
        
        console_thread = threading.Thread(
            target=self.console_interface,
            args=(self.loop,),
            daemon=True
        )
        console_thread.start()
        
        async with serve(self.handle_client, host, port):
            self.log_activity(f"{self.C['green']}[SRV]{self.C['reset']}     Server started on {host}:{port}")
            
            try:
                while self.running:
                    await asyncio.sleep(1)
            except KeyboardInterrupt:
                self.running = False
                print(f"\n{self.C['red']}[!] Shutting down...{self.C['reset']}")
            finally:
                for client_id in list(self.clients.keys()):
                    try:
                        await self.clients[client_id]['ws'].close()
                    except:
                        pass
                self.clients.clear()

def main():
    console = SecureNeuralConsole()
    
    def signal_handler(sig, frame):
        console.running = False
        print(f"\n{console.C['red']}[!] Server stopped{console.C['reset']}")
        sys.exit(0)
    
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    try:
        asyncio.run(console.start_server())
    except KeyboardInterrupt:
        console.running = False
        print(f"\n{console.C['red']}[!] Server stopped{console.C['reset']}")
    except Exception as e:
        print(f"{console.C['red']}[!] Fatal error: {e}{console.C['reset']}")

if __name__ == "__main__":
    main()
